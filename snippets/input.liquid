{%- comment -%}
  {% render 'input',
    type: 'text' | 'search' | 'select' | 'qty',
    name: 'q',
    id: 'search',
    label: 'Buscar',
    placeholder: '...',
    value: '',
    error: '',
    hint: '',
    options: 'opt1,opt2' (for select),
    min: 1, max: 99 (for qty)
  %}
{%- endcomment -%}
{%- liquid
  assign input_type = type | default: 'text'
  assign input_id = id | default: name
  assign input_name = name | default: 'field'
  assign input_value = value | default: ''
  assign has_error = false
  if error != blank
    assign has_error = true
  endif
-%}

<div class="nt-input-wrap"{% if input_type == 'qty' %} x-data="{ qty: {{ input_value | default: 1 }} }"{% endif %}>
  {%- if label != blank -%}
    <label class="nt-label" for="{{ input_id }}">{{ label }}</label>
  {%- endif -%}

  {%- case input_type -%}
    {%- when 'search' -%}
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted pointer-events-none">
          {% render 'icon', name: 'search', size: 18 %}
        </span>
        <input
          type="search"
          id="{{ input_id }}"
          name="{{ input_name }}"
          class="nt-input pl-10{% if has_error %} nt-input--error{% endif %}"
          placeholder="{{ placeholder | default: 'general.search' | t }}"
          value="{{ input_value }}"
          autocomplete="off"
        >
      </div>

    {%- when 'select' -%}
      <select
        id="{{ input_id }}"
        name="{{ input_name }}"
        class="nt-input{% if has_error %} nt-input--error{% endif %}"
      >
        {%- assign opt_list = options | split: ',' -%}
        {%- for opt in opt_list -%}
          {%- assign opt_parts = opt | split: ':' -%}
          <option value="{{ opt_parts[0] | strip }}">{{ opt_parts[1] | default: opt_parts[0] | strip }}</option>
        {%- endfor -%}
      </select>

    {%- when 'qty' -%}
      <div class="flex items-center gap-0 border border-line rounded-md overflow-hidden w-fit">
        <button
          type="button"
          class="flex items-center justify-center w-11 h-11 hover:bg-surface-2 transition-colors"
          @click="qty = Math.max({{ min | default: 1 }}, qty - 1)"
          aria-label="Disminuir cantidad"
        >
          {% render 'icon', name: 'minus', size: 16 %}
        </button>
        <input
          type="number"
          id="{{ input_id }}"
          name="{{ input_name }}"
          class="nt-input w-14 text-center border-0 border-x border-line rounded-none min-h-11"
          x-model.number="qty"
          min="{{ min | default: 1 }}"
          {% if max != blank %}max="{{ max }}"{% endif %}
        >
        <button
          type="button"
          class="flex items-center justify-center w-11 h-11 hover:bg-surface-2 transition-colors"
          @click="qty = Math.min({{ max | default: 99 }}, qty + 1)"
          aria-label="Aumentar cantidad"
        >
          {% render 'icon', name: 'plus', size: 16 %}
        </button>
      </div>

    {%- else -%}
      <input
        type="{{ input_type }}"
        id="{{ input_id }}"
        name="{{ input_name }}"
        class="nt-input{% if has_error %} nt-input--error{% endif %}"
        placeholder="{{ placeholder }}"
        value="{{ input_value }}"
      >
  {%- endcase -%}

  {%- if hint != blank -%}
    <span class="nt-input-hint">{{ hint }}</span>
  {%- endif -%}
  {%- if has_error -%}
    <span class="nt-input-error" role="alert">{{ error }}</span>
  {%- endif -%}
</div>
