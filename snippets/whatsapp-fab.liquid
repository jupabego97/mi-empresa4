{%- liquid
  assign hide_on_product = false
  if template.name == 'product'
    assign hide_on_product = true
  endif
-%}
{%- if settings.show_whatsapp_fab and settings.whatsapp_number != blank and hide_on_product == false -%}
  {%- liquid
    assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
    assign wa_text = settings.whatsapp_message | url_encode
    assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  -%}
  <a
    href="{{ wa_url }}"
    class="nt-whatsapp-fab"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'general.whatsapp' | t }}"
  >
    {% render 'icon', name: 'whatsapp', size: 28 %}
  </a>
{%- endif -%}
