{%- comment -%}
  Product price: {% render 'price', product: product %}
  Manual: {% render 'price', price: 2999000, compare_at: 3499000, installments: '12 cuotas' %}
  Variants: size: 'lg' (for PDP)
{%- endcomment -%}
{%- liquid
  if product != blank
    assign current_price = product.price
    assign compare_price = product.compare_at_price
  else
    assign current_price = price | default: 0
    assign compare_price = compare_at | default: 0
  endif

  assign show_installments = installments | default: ''
  assign discount_pct = 0
  if compare_price > current_price and compare_price > 0
    assign discount_amount = compare_price | minus: current_price
    assign discount_pct = discount_amount | times: 100 | divided_by: compare_price
  endif

  assign price_class = 'nt-price'
  if size == 'lg'
    assign price_class = 'nt-price nt-price--lg'
  endif
-%}

<div class="{{ price_class }}">
  <div class="nt-price__row">
    <span class="nt-price__current">{{ current_price | money }}</span>
    {%- if compare_price > current_price -%}
      <span class="nt-price__compare">{{ compare_price | money }}</span>
      <span class="nt-price__discount">-{{ discount_pct }}%</span>
    {%- endif -%}
  </div>
  {%- if show_installments != blank -%}
    <span class="nt-price__installments">{{ show_installments }}</span>
  {%- elsif current_price > 0 -%}
    <span class="nt-price__installments text-ink-muted">
      Cuotas según Mercado Pago en checkout
    </span>
  {%- endif -%}
</div>
