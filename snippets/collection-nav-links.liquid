{%- comment -%}
  Colecciones por handle (settings.nav_collection_handles).
  Liquid no itera `collections`; solo `collections[handle]`.
{%- endcomment -%}
{%- liquid
  assign handles_source = settings.nav_collection_handles | default: ''
  if handles_source == blank
    assign handles_source = 'catalogo-destacado|accesorios|cables|power-bank|parlantes|diademas|belleza'
    assign handles_lines = handles_source | split: '|'
  else
    assign handles_lines = handles_source | newline_to_br | split: '<br />'
  endif
  assign link_class = link_class | default: 'nt-megamenu__link'
-%}
{%- for line in handles_lines -%}
  {%- assign handle = line | strip -%}
  {%- if handle != blank and handle != 'frontpage' -%}
    {%- assign col = collections[handle] -%}
    {%- assign col_url = col.url -%}
    {%- if col_url == blank -%}
      {%- assign col_url = routes.collections_url | append: '/' | append: handle -%}
    {%- endif -%}
    {%- if col != blank or handle != blank -%}
      {%- assign nav_title = col.title | default: handle | replace: '-', ' ' | capitalize -%}
      <a href="{{ col_url }}" class="{{ link_class }}">
        {%- if show_icon -%}
          {%- capture nav_theme -%}{% render 'category-theme', handle: handle, title: nav_title %}{%- endcapture -%}
          {%- assign nav_icon = nav_theme | strip | split: '|' | last -%}
          {%- if nav_icon == blank -%}{%- assign nav_icon = 'grid' -%}{%- endif -%}
          {% render 'icon', name: nav_icon, size: 16, class: 'text-brand-royal shrink-0' %}
        {%- endif -%}
        <span>{{ nav_title }}</span>
        {%- if show_count and col != blank -%}
          <span class="ml-auto text-xs text-ink-subtle">{{ col.products_count }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
