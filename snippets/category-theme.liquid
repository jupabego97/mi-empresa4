{%- comment -%}
  Devuelve asset|icon para una categoría.
  {% render 'category-theme', handle: 'parlantes', title: 'Parlantes', icon: 'cpu' %}
{%- endcomment -%}
{%- liquid
  assign h = handle | default: '' | downcase | strip
  assign t = title | default: '' | downcase | strip
  assign fallback_icon = icon | default: 'grid'
  assign theme_asset = ''
  assign theme_icon = fallback_icon

  if h == 'parlantes' or t contains 'parlante' or t contains 'speaker'
    assign theme_asset = 'category-parlantes.svg'
    assign theme_icon = 'speaker'
  elsif h == 'diademas' or t contains 'diadema' or t contains 'audífono' or t contains 'audifono' or t contains 'headset'
    assign theme_asset = 'category-diademas.svg'
    assign theme_icon = 'headset'
  elsif t contains 'audio' or t contains 'sonido'
    assign theme_icon = 'headphones'
  elsif h == 'power-bank' or h == 'powerbank' or t contains 'power bank' or t contains 'batería' or t contains 'bateria'
    assign theme_asset = 'category-power-bank.svg'
    assign theme_icon = 'battery'
  elsif h == 'cables' or t contains 'cable'
    assign theme_asset = 'category-cables.svg'
    assign theme_icon = 'cable'
  elsif h == 'accesorios' or t contains 'accesorio'
    assign theme_asset = 'category-accesorios.svg'
    assign theme_icon = 'plug'
  elsif h == 'belleza' or t contains 'belleza' or t contains 'cuidado personal'
    assign theme_asset = 'category-belleza.svg'
    assign theme_icon = 'sparkle'
  elsif h == 'catalogo-destacado' or t contains 'destacado' or t contains 'oferta'
    assign theme_asset = 'category-destacados.svg'
    assign theme_icon = 'star'
  elsif t contains 'portátil' or t contains 'portatil' or t contains 'laptop' or t contains 'notebook'
    assign theme_icon = 'laptop'
  elsif t contains 'monitor' or t contains 'pantalla'
    assign theme_icon = 'monitor'
  elsif t contains 'gamer' or t contains 'gaming' or t contains 'consola'
    assign theme_icon = 'gamepad'
  elsif t contains 'teclado' or t contains 'mouse' or t contains 'periférico' or t contains 'periferico'
    assign theme_icon = 'keyboard'
  elsif t contains 'red' or t contains 'wifi' or t contains 'router'
    assign theme_icon = 'wifi'
  elsif t contains 'pc' or t contains 'computador' or t contains 'componente' or t contains 'procesador'
    assign theme_icon = 'cpu'
  elsif t contains 'cargador' or t contains 'energía' or t contains 'energia'
    assign theme_icon = 'plug'
  elsif t contains 'almacenamiento' or t contains 'usb' or t contains 'memoria'
    assign theme_icon = 'package'
  endif

  echo theme_asset | append: '|' | append: theme_icon
-%}
