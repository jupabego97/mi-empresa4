{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_prefix = settings.whatsapp_message_product | default: 'Hola, me interesa este producto:'
  assign wa_msg = wa_prefix | append: ' ' | append: product.title | append: ' — ' | append: request.origin | append: product.url
  assign wa_text = wa_msg | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

{%- form 'product', product, id: 'product-form', class: 'space-y-4 ajax-cart' -%}
  {%- if product.options_with_values.size > 0 and product.has_only_default_variant == false -%}
    {%- for option in product.options_with_values -%}
      <fieldset class="border-0 p-0 m-0">
        <legend class="nt-label block mb-2">
          {{ option.name }}:
          <span class="text-ink-muted font-normal" data-option-current="{{ option.position }}">{{ option.selected_value }}</span>
        </legend>
        <div class="flex flex-wrap gap-2" data-option-fieldset="{{ option.position }}">
          {%- for value in option.values -%}
            <label class="cursor-pointer variant-option-label" data-option-value="{{ value | escape }}">
              <input
                type="radio"
                name="option-{{ option.position }}"
                value="{{ value | escape }}"
                class="peer sr-only variant-option-input"
                data-option-position="{{ option.position }}"
                {% if value == option.selected_value %}checked{% endif %}
              >
              <span class="variant-option-pill inline-flex items-center px-3 py-2 text-sm rounded-md border border-line bg-surface peer-checked:border-brand-royal peer-checked:bg-brand-sky peer-checked:text-brand-royal peer-checked:font-semibold peer-disabled:opacity-40 peer-disabled:cursor-not-allowed transition-colors hover:border-ink-muted">
                {{ value }}
              </span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}

    <select name="id" id="product-variant-id" class="nt-sr-only" aria-hidden="true" tabindex="-1">
      {%- for variant in product.variants -%}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}selected{% endif %}
          {% unless variant.available %}disabled{% endunless %}
        >
          {{ variant.title }}
        </option>
      {%- endfor -%}
    </select>
  {%- else -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}">
  {%- endif -%}

  <div class="flex items-center gap-3 flex-wrap">
    <div>
      {% render 'input', type: 'qty', name: 'quantity', id: 'product-qty', label: 'Cantidad', value: 1, min: 1, max: 99 %}
    </div>
    <p class="text-xs text-ink-muted">
      SKU: <span id="product-sku">{{ current_variant.sku | default: 'N/A' }}</span>
    </p>
  </div>

  {%- capture add_label -%}{{ 'general.add_to_cart' | t }}{%- endcapture -%}
  {%- capture buy_label -%}{{ 'general.buy_now' | t }}{%- endcapture -%}
  {%- capture wa_label -%}{{ 'general.talk_advisor' | t }}{%- endcapture -%}

  <div class="flex flex-col gap-3">
    <button
      type="submit"
      name="add"
      id="product-add-btn"
      class="nt-btn nt-btn--primary nt-btn--xl nt-btn--full product-add-btn cursor-pointer"
      data-add-btn
      data-variant-id="{{ current_variant.id }}"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {% render 'icon', name: 'cart', size: 18 %}
      <span id="product-add-btn-label">{{ add_label }}</span>
    </button>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2">
      {% render 'btn', variant: 'dark', size: 'lg', label: buy_label, type: 'submit', name: 'checkout', icon: 'zap', full: true %}
      <span class="hidden lg:contents">
        {% render 'btn', variant: 'whatsapp', size: 'lg', label: wa_label, icon: 'whatsapp', href: wa_url, target: '_blank', rel: 'noopener', full: true %}
      </span>
    </div>
  </div>
{%- endform -%}

<script type="application/json" id="product-json">
  {{ product | json }}
</script>

<script type="application/json" id="product-variant-images">
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": {%- liquid
        assign img_index = 0
        if variant.featured_image
          for image in product.images
            if image.id == variant.featured_image.id
              assign img_index = forloop.index0
            endif
          endfor
        endif
      -%}{{ img_index }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>
