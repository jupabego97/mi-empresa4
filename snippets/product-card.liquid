{%- comment -%}
  {% render 'product-card', product: product %}
  Demo: {% render 'product-card', demo: true, title: '...', price: 2999000, ... %}
{%- endcomment -%}
{%- liquid
  if demo
    assign card_title = title | default: 'Producto demo'
    assign card_url = url | default: '#'
    assign card_price = price | default: 199900000
    assign card_compare = compare_at | default: 0
    assign card_available = available | default: true
    assign card_rating = rating | default: 4.8
    assign card_reviews = reviews | default: 27
    assign card_badge = badge | default: ''
    assign card_brand = brand | default: ''
    assign card_installments = installments | default: ''
    assign card_image = image
    assign card_id = forloop.index | default: 0
  else
    assign card_product = product
    assign card_title = card_product.title
    assign card_url = card_product.url
    assign card_price = card_product.price
    assign card_compare = card_product.compare_at_price
    assign card_available = card_product.available
    assign card_rating = 5
    assign card_reviews = 0
    assign card_badge = ''
    assign card_brand = card_product.vendor
    if card_product.compare_at_price > card_product.price
      assign card_badge = 'oferta'
    endif
    assign card_image = card_product.featured_image
    assign card_id = card_product.id
    assign card_installments = ''
  endif

  assign threshold_cop = settings.free_shipping_threshold | default: 200000
  assign threshold_cents = threshold_cop | times: 100
  assign free_shipping = false
  if card_price >= threshold_cents
    assign free_shipping = true
  endif

  assign stock_label = 'general.in_stock' | t
  assign stock_class = 'text-success'
  assign stock_dot = 'bg-success'
  if card_available == false
    assign stock_label = 'general.out_of_stock' | t
    assign stock_class = 'text-danger'
    assign stock_dot = 'bg-danger'
  elsif low_stock
    assign stock_label = 'general.low_stock' | t
    assign stock_class = 'text-warning'
    assign stock_dot = 'bg-warning'
  endif
-%}

<article class="nt-product-card group"{% if card_available == false %} data-sold-out{% endif %}>
  <a href="{{ card_url }}" class="nt-product-card__media block">
    <div class="nt-product-card__badges">
      {%- if card_badge == 'oferta' -%}
        {%- if card_compare > 0 and card_price > 0 -%}
          {%- assign disc = card_compare | minus: card_price | times: 100 | divided_by: card_compare -%}
          {% render 'badge', variant: 'oferta', label: '-' | append: disc | append: '%' %}
        {%- else -%}
          {% render 'badge', variant: 'oferta' %}
        {%- endif -%}
      {%- elsif card_badge == 'nuevo' -%}
        {% render 'badge', variant: 'nuevo' %}
      {%- elsif card_badge == 'stock-bajo' -%}
        {% render 'badge', variant: 'stock-bajo' %}
      {%- endif -%}
      {%- if free_shipping and card_available -%}
        {% render 'badge', variant: 'envio-gratis' %}
      {%- endif -%}
    </div>

    <button
      type="button"
      class="nt-product-card__wishlist"
      aria-label="Guardar en favoritos"
      data-wishlist="{{ card_id }}"
      onclick="event.preventDefault(); this.classList.toggle('!text-danger')"
    >
      {% render 'icon', name: 'heart', size: 18 %}
    </button>

    {%- if card_image != blank -%}
      {{
        card_image
        | image_url: width: 700
        | image_tag:
          loading: 'lazy',
          widths: '300,500,700',
          sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw',
          class: 'absolute inset-0 w-full h-full object-contain p-3 transition-transform duration-300 group-hover:scale-105',
          alt: card_title
      }}
    {%- else -%}
      <div class="w-full h-full flex items-center justify-center bg-surface-2 text-ink-muted text-sm p-4 text-center">
        {% render 'icon', name: 'package', size: 48, class: 'opacity-30' %}
      </div>
    {%- endif -%}
  </a>

  <div class="nt-product-card__body">
    {%- if card_brand != blank -%}
      <span class="nt-product-card__brand">{{ card_brand }}</span>
    {%- endif -%}

    <a href="{{ card_url }}" class="nt-product-card__title hover:text-brand-royal transition-colors">
      {{ card_title }}
    </a>

    {%- if card_reviews > 0 -%}
      <div class="nt-product-card__rating">
        <span class="inline-flex items-center gap-0.5">
          {%- for i in (1..5) -%}
            {% render 'icon', name: 'star', size: 12, class: 'text-warning fill-warning' %}
          {%- endfor -%}
        </span>
        <span>({{ card_reviews }})</span>
      </div>
    {%- endif -%}

    {% render 'price', price: card_price, compare_at: card_compare, installments: card_installments %}

    <p class="text-xs font-medium {{ stock_class }} inline-flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full {{ stock_dot }}"></span>
      {{ stock_label }}
    </p>

    {%- capture add_label -%}{{ 'general.add_to_cart' | t }}{%- endcapture -%}
    {%- capture options_label -%}{{ 'general.choose_options' | t }}{%- endcapture -%}
    {%- capture sold_label -%}{{ 'general.out_of_stock' | t }}{%- endcapture -%}

    <div class="nt-product-card__actions">
      {%- if card_available -%}
        {%- if demo == blank and card_product.has_only_default_variant -%}
          <form action="{{ routes.cart_add_url }}" method="post" class="flex-1 ajax-cart-quick" data-redirect-to="{{ routes.cart_url }}">
            <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="nt-btn nt-btn--primary nt-btn--sm w-full" data-add-btn>
              {% render 'icon', name: 'cart', size: 14 %}
              <span data-add-btn-label>{{ add_label }}</span>
            </button>
          </form>
        {%- elsif demo == blank -%}
          {% render 'btn', variant: 'primary', size: 'sm', label: options_label, href: card_url, class: 'flex-1', icon: 'arrow-right' %}
        {%- else -%}
          {% render 'btn', variant: 'primary', size: 'sm', label: add_label, type: 'button', class: 'flex-1', icon: 'cart' %}
        {%- endif -%}
      {%- else -%}
        {% render 'btn', variant: 'secondary', size: 'sm', label: sold_label, disabled: true, class: 'flex-1' %}
      {%- endif -%}
    </div>
  </div>
</article>
