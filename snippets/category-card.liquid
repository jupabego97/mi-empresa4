<a href="{{ url | default: '#' }}" class="nt-category-card group">
  <span class="nt-category-card__halo" aria-hidden="true"></span>
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 700
      | image_tag:
        loading: 'lazy',
        class: 'nt-category-card__media-img transition-transform duration-500 group-hover:scale-105',
        alt: title,
        widths: '300,500,700',
        sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 16vw'
    }}
  {%- elsif image_asset != blank -%}
    <img
      src="{{ image_asset | asset_url }}"
      alt=""
      class="nt-category-card__media-img nt-category-card__media-img--asset transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      width="400"
      height="500"
    >
  {%- else -%}
    <div class="absolute inset-0 bg-gradient-to-br from-brand-royal via-brand-electric to-brand-deep"></div>
    <div class="absolute inset-0 nt-tech-grid opacity-30"></div>
    {%- if icon != blank -%}
      <div class="absolute inset-0 flex items-center justify-center text-white/20">
        {% render 'icon', name: icon, size: 96 %}
      </div>
    {%- endif -%}
  {%- endif -%}
  {%- if icon != blank -%}
    <span class="nt-category-card__icon" aria-hidden="true">
      {% render 'icon', name: icon, size: 24 %}
    </span>
  {%- endif -%}
  <span class="nt-category-card__overlay" aria-hidden="true"></span>
  <div class="nt-category-card__content">
    {%- assign eyebrow_clean = eyebrow | strip -%}
    {%- if eyebrow_clean != blank -%}
      <span class="block text-[10px] font-bold uppercase tracking-wider text-white/70 mb-1">{{ eyebrow_clean }}</span>
    {%- endif -%}
    <span class="nt-category-card__title">{{ title }}</span>
    <span class="nt-category-card__cta">
      <span>Ver más</span>
      {% render 'icon', name: 'arrow-right', size: 12 %}
    </span>
  </div>
</a>
