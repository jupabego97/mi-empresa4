{%- liquid
  assign page_title = page_title | default: shop.name
  assign page_description = page_description | default: settings.meta_description_default | default: shop.description
  assign page_image = page_image | default: settings.logo | default: shop.brand.logo
  assign canonical_url = canonical_url | default: request.origin | append: request.path
  assign street = settings.store_street_address | default: settings.store_address
  assign geo_lat = settings.store_geo_lat | default: '6.0834861'
  assign geo_lng = settings.store_geo_lng | default: '-75.3339518'
  assign schema_image = page_image
  if schema_image == blank and settings.logo != blank
    assign schema_image = settings.logo
  endif
  assign is_product = false
  if request.page_type == 'product' and product
    assign is_product = true
    assign current_variant = product.selected_or_first_available_variant
    if product.featured_media
      assign page_image = product.featured_media.preview_image | default: product.featured_image
    elsif product.featured_image
      assign page_image = product.featured_image
    endif
  endif
-%}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{{ settings.color_brand_deep | default: '#051640' }}">

<title>
  {{ page_title }}
  {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
</title>

{%- if page_description != blank -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<link rel="canonical" href="{{ canonical_url }}">

{%- if noindex -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{% if is_product %}product{% else %}website{% endif %}">
{%- if page_description != blank -%}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}
{%- if page_image != blank -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}
{%- if is_product -%}
  <meta property="product:price:amount" content="{{ current_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if page_description != blank -%}
  <meta name="twitter:description" content="{{ page_description | escape }}">
{%- endif -%}
{%- if page_image != blank -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}

{%- unless minimal -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": {{ shop.url | append: '/#localbusiness' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "description": {{ settings.meta_description_default | default: page_description | json }},
  {%- if schema_image != blank -%}
  "image": {{ schema_image | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- else -%}
  "image": {{ shop.url | json }},
  {%- endif -%}
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ street | json }},
    "addressLocality": "El Carmen de Viboral",
    "addressRegion": "Antioquia",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ geo_lat | json }},
    "longitude": {{ geo_lng | json }}
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "10:00",
      "closes": "20:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "10:00",
      "closes": "19:00"
    }
  ]
  {%- if settings.store_phone != blank -%}
  ,"telephone": {{ settings.store_phone | json }}
  {%- endif -%}
  {%- liquid
    assign ig_handle = settings.instagram_handle | default: 'nanotronics.com.co' | replace: '@', '' | strip
    assign ig_url = settings.social_instagram | strip
    if ig_url == blank and ig_handle != blank
      assign ig_url = 'https://www.instagram.com/' | append: ig_handle | append: '/'
    endif
  -%}
  {%- if ig_url != blank -%}
  ,"sameAs": [{{ ig_url | json }}]
  {%- endif -%}
  ,"areaServed": {
    "@type": "Country",
    "name": "Colombia"
  }
}
</script>

{%- if is_product -%}
  {%- liquid
    assign offer_url = request.origin | append: product.url
    assign availability = 'https://schema.org/OutOfStock'
    if current_variant.available
      assign availability = 'https://schema.org/InStock'
    endif
    assign product_image = blank
    if product.featured_media
      assign product_image = product.featured_media.preview_image | default: product.featured_image
    elsif product.featured_image
      assign product_image = product.featured_image
    endif
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ offer_url | json }},
  "description": {{ product.description | strip_html | truncate: 5000 | json }},
  {%- if product.vendor != blank -%}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- endif -%}
  {%- if current_variant.sku != blank -%}
  "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  {%- if product_image != blank -%}
  "image": [
    {{ product_image | image_url: width: 1200 | prepend: 'https:' | json }}
  ],
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": {{ offer_url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
    "price": {{ current_variant.price | money_without_currency | replace: ',', '' | strip | json }},
    "availability": {{ availability | json }},
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
}
</script>
{%- endif -%}
{%- endunless -%}
