{%- liquid
  assign page_title = page_title | default: shop.name
  assign page_description = page_description | default: settings.meta_description_default | default: shop.description
  assign page_image = page_image | default: settings.logo | default: shop.brand.logo
  assign canonical_url = canonical_url | default: request.origin | append: request.path
  assign street = settings.store_street_address | default: settings.store_address
  assign geo_lat = settings.store_geo_lat | default: '6.0823'
  assign geo_lng = settings.store_geo_lng | default: '-75.3351'
-%}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{{ settings.color_brand_deep | default: '#051640' }}">

<title>
  {{ page_title }}
  {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
</title>

{%- if page_description != blank -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="website">
{%- if page_description != blank -%}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}
{%- if page_image != blank -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if page_description != blank -%}
  <meta name="twitter:description" content="{{ page_description | escape }}">
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": {{ shop.url | append: '/#localbusiness' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "description": {{ page_description | json }},
  "image": {{ shop.url | append: '/cdn/shop/files/logo.png' | json }},
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ street | json }},
    "addressLocality": "El Carmen de Viboral",
    "addressRegion": "Antioquia",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ geo_lat | json }},
    "longitude": {{ geo_lng | json }}
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "10:00",
      "closes": "20:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "10:00",
      "closes": "19:00"
    }
  ]
  {%- if settings.store_phone != blank -%}
  ,"telephone": {{ settings.store_phone | json }}
  {%- endif -%}
  {%- if settings.store_email != blank -%}
  ,"email": {{ settings.store_email | json }}
  {%- endif -%}
  ,"areaServed": {
    "@type": "Country",
    "name": "Colombia"
  }
}
</script>
