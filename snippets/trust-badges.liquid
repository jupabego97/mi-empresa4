{%- liquid
  assign returns_days = settings.returns_days | default: 15
  assign warranty_note = settings.product_warranty_note | default: 'Garantía mínima de 3 meses en productos, según política de la marca y NANOTRONICS.'
  assign publish_shipping = settings.publish_shipping_claims
-%}
<div class="nt-trust-row">
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'truck', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Envío a Colombia</span>
      {%- if publish_shipping -%}
        <span class="nt-trust-item__desc">{{ settings.shipping_national | default: 'Consulta tiempos' }} · Medellín {{ settings.shipping_medellin | default: 'consulta' }}</span>
      {%- else -%}
        <span class="nt-trust-item__desc">Tiempos y costo en checkout · también recoges en tienda</span>
      {%- endif -%}
    </span>
  </div>
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'shield-check', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Garantía respaldada</span>
      <span class="nt-trust-item__desc">{{ warranty_note | truncate: 90 }}</span>
    </span>
  </div>
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'credit-card', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Compra protegida</span>
      <span class="nt-trust-item__desc">Mercado Pago · Transferencia · Efectivo en tienda</span>
    </span>
  </div>
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'rotate', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Cambios en {{ returns_days }} días</span>
      <span class="nt-trust-item__desc">Si algo no te convence, lo resolvemos contigo</span>
    </span>
  </div>
</div>
