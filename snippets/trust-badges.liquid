<div class="nt-trust-row">
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'truck', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Despacho hoy mismo</span>
      <span class="nt-trust-item__desc">Llega en 2-5 días · gratis desde $200K</span>
    </span>
  </div>
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'shield-check', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Garantía oficial</span>
      <span class="nt-trust-item__desc">Respaldo del fabricante + posventa</span>
    </span>
  </div>
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'credit-card', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Compra protegida</span>
      <span class="nt-trust-item__desc">Visa · Mastercard · PSE · Nequi · Addi</span>
    </span>
  </div>
  <div class="nt-trust-item">
    <span class="nt-trust-item__icon">{% render 'icon', name: 'rotate', size: 18 %}</span>
    <span>
      <span class="nt-trust-item__title">Cambios en 5 días</span>
      <span class="nt-trust-item__desc">Si algo no te convence, lo resolvemos</span>
    </span>
  </div>
</div>
