{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = 'Hola, quiero visitar la tienda NANOTRONICS' | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  assign place_url = settings.google_maps_place_url | strip
-%}
{%- capture maps_reviews -%}{% render 'google-maps-href', kind: 'place' %}{%- endcapture -%}
{%- assign maps_reviews_url = maps_reviews | strip -%}
{%- capture maps_directions -%}{% render 'google-maps-href', kind: 'directions' %}{%- endcapture -%}
{%- assign maps_directions_url = maps_directions | strip -%}

<section class="nt-section bg-surface-2">
  <div class="nt-container">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
      <div>
        <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow | default: 'Tienda física' }}</p>
        <h2 class="nt-section-title mb-3">{{ section.settings.title }}</h2>
        <p class="text-ink-muted mb-6 max-w-lg">{{ section.settings.description }}</p>

        <div class="space-y-4 mb-8">
          <div class="flex items-start gap-3 p-4 rounded-xl border border-line bg-surface">
            {% render 'icon', name: 'map-pin', size: 20, class: 'text-brand-royal shrink-0 mt-0.5' %}
            <div>
              <p class="font-semibold text-ink">Dirección</p>
              <p class="text-sm text-ink-muted mt-1">{{ settings.store_address }}</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-4 rounded-xl border border-line bg-surface">
            {% render 'icon', name: 'clock', size: 20, class: 'text-brand-royal shrink-0 mt-0.5' %}
            <div>
              <p class="font-semibold text-ink">Horario</p>
              <p class="text-sm text-ink-muted mt-1">{{ settings.store_hours }}</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-4 rounded-xl border border-line bg-surface">
            {% render 'icon', name: 'whatsapp', size: 20, class: 'text-[#25D366] shrink-0 mt-0.5' %}
            <div>
              <p class="font-semibold text-ink">Atención al cliente</p>
              <a href="{{ wa_url }}" target="_blank" rel="noopener" class="text-sm text-brand-royal hover:underline mt-1 inline-block">
                WhatsApp · {{ settings.store_phone }}
              </a>
              <p class="text-xs text-ink-muted mt-1">{{ settings.customer_service_note | default: 'Atención al cliente solo por WhatsApp.' }}</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-4 rounded-xl border border-line bg-surface">
            {% render 'icon', name: 'instagram', size: 20, class: 'text-brand-royal shrink-0 mt-0.5' %}
            <div>
              <p class="font-semibold text-ink">Instagram</p>
              {% render 'instagram-link', style: 'text', icon_size: 16, class: 'text-sm text-brand-royal hover:underline mt-1', icon_class: 'text-brand-royal' %}
            </div>
          </div>
        </div>

        <div class="nt-card p-5 mb-6">
          <p class="text-sm font-semibold text-ink mb-2 inline-flex items-center gap-2">
            {% render 'icon', name: 'star', size: 16, class: 'text-warning fill-warning' %}
            Calificación en Google
          </p>
          <p class="text-2xl font-bold text-ink mb-1">{{ settings.metric_rating_value | default: '4.3★' }}</p>
          <p class="text-sm text-ink-muted mb-4">
            Promedio público en Google Maps. Las opiniones las lees directamente en Google — no inventamos testimonios en la web.
          </p>
          <a
            href="{{ maps_reviews_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-brand-royal hover:underline inline-flex items-center gap-1"
          >
            Ver ficha y reseñas en Google Maps
            {% render 'icon', name: 'arrow-right', size: 14 %}
          </a>
        </div>

        <div class="flex flex-wrap gap-3">
          {%- if place_url != blank -%}
            <a href="{{ place_url }}" target="_blank" rel="noopener noreferrer" class="nt-btn nt-btn--primary nt-btn--lg inline-flex items-center gap-2">
              {% render 'icon', name: 'map-pin', size: 18 %}
              Cómo llegar
            </a>
          {%- else -%}
            {% render 'btn', variant: 'primary', size: 'lg', label: 'Cómo llegar', href: maps_directions_url, target: '_blank', rel: 'noopener', icon: 'map-pin' %}
          {%- endif -%}
          {% render 'btn', variant: 'whatsapp', size: 'lg', label: 'WhatsApp', href: wa_url, target: '_blank', rel: 'noopener', icon: 'whatsapp' %}
        </div>
      </div>

      <div>
        {% render 'store-map', height: 420, show_links: true, title: section.settings.title %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Ubicación",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Parque Principal · El Carmen de Viboral" },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Visítanos en el Carmen"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Desde 2005 en la Calle 30 # 30-31, frente al Parque Principal. Tienda y servicio técnico en un solo lugar — recoge tu pedido sin costo."
    }
  ],
  "presets": [{ "name": "Home — Ubicación" }]
}
{% endschema %}
