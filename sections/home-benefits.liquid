<section class="nt-section bg-surface-2">
  <div class="nt-container">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow | default: 'Compra con confianza' }}</p>
      <h2 class="nt-section-title text-center mb-2">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="text-ink-muted">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 lg:gap-4">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {% render 'benefit-item',
            icon: block.settings.icon,
            title: block.settings.title,
            text: block.settings.text
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Beneficios",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Por qué NANOTRONICS" },
    { "type": "text", "id": "title", "label": "Título", "default": "Buen precio, variedad y atención" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Desde 2005 en el Parque Principal. 4.3★ en Google. Tienda física y servicio técnico en un solo lugar." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícono", "options": [
          { "value": "truck", "label": "Envío" },
          { "value": "shield-check", "label": "Garantía" },
          { "value": "credit-card", "label": "Pagos" },
          { "value": "headset", "label": "Asesoría / Soporte" },
          { "value": "map-pin", "label": "Tienda física" },
          { "value": "star", "label": "Calidad" },
          { "value": "tool", "label": "Servicio técnico" },
          { "value": "rotate", "label": "Devoluciones" },
          { "value": "award", "label": "Premio" },
          { "value": "package", "label": "Empaque" }
        ], "default": "shield-check" },
        { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Descripción breve" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home — Beneficios",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "award", "title": "Buen precio", "text": "Relación costo-beneficio en la región" } },
        { "type": "benefit", "settings": { "icon": "package", "title": "Amplia variedad", "text": "Tecnología, accesorios, audio, belleza y más" } },
        { "type": "benefit", "settings": { "icon": "headset", "title": "Excelente atención", "text": "WhatsApp con respuesta en ~5 min" } },
        { "type": "benefit", "settings": { "icon": "map-pin", "title": "Parque Principal", "text": "Calle 30 # 30-31, El Carmen de Viboral" } },
        { "type": "benefit", "settings": { "icon": "shield-check", "title": "Garantía mín. 3 meses", "text": "En productos, según política" } },
        { "type": "benefit", "settings": { "icon": "tool", "title": "Servicio técnico", "text": "Taller en la misma tienda" } }
      ]
    }
  ]
}
{% endschema %}
