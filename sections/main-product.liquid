{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_prefix = settings.whatsapp_message_product | default: 'Hola, me interesa este producto:'
  assign wa_msg = wa_prefix | append: ' ' | append: product.title | append: ' — ' | append: request.origin | append: product.url
  assign wa_text = wa_msg | url_encode
  assign wa_product_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text

  assign current_variant = product.selected_or_first_available_variant
  assign threshold_cop = settings.free_shipping_threshold | default: 200000
  assign threshold_cents = threshold_cop | times: 100
  assign free_shipping = false
  if product.price >= threshold_cents
    assign free_shipping = true
  endif

  assign shipping_cutoff = settings.shipping_cutoff_time | default: '3:00 pm'
  assign shipping_national = settings.shipping_national | default: '2-5 días hábiles'
  assign shipping_medellin = settings.shipping_medellin | default: '1-2 días hábiles'
  assign product_warranty = settings.product_warranty_note | default: 'Garantía mínima de 3 meses en productos, según política de la marca y NANOTRONICS.'
  assign returns_days = settings.returns_days | default: 5
-%}

{% render 'breadcrumbs' %}

<section class="nt-section pt-0 pb-32 lg:pb-16">
  <div class="nt-container">
    <div class="nt-pdp-grid mb-12">
      <div>
        {% render 'product-gallery', product: product %}
      </div>

      <div class="space-y-5">
        {%- if product.vendor != blank -%}
          <p class="nt-eyebrow">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 style="font-size: var(--text-h1)" class="font-bold tracking-tight leading-tight text-ink">
          {{ product.title }}
        </h1>

        <div class="flex items-center gap-3 flex-wrap">
          <a
            href="{% render 'google-maps-href', kind: 'search' %}"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-sm hover:text-brand-royal transition-colors"
          >
            <span class="inline-flex items-center gap-0.5" aria-hidden="true">
              {%- for i in (1..4) -%}
                {% render 'icon', name: 'star', size: 14, class: 'text-warning fill-warning' %}
              {%- endfor -%}
              {% render 'icon', name: 'star', size: 14, class: 'text-warning/35' %}
            </span>
            <span class="font-medium text-ink">{{ settings.metric_rating_value | default: '4.3★' }}</span>
            <span class="text-ink-muted">en Google · tienda física</span>
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {%- if product.compare_at_price > product.price -%}
            {% render 'badge', variant: 'oferta' %}
          {%- endif -%}
          {%- if free_shipping -%}
            {% render 'badge', variant: 'envio-gratis' %}
          {%- endif -%}
          {% render 'badge', variant: 'garantia', label: 'Garantía respaldada' %}
          {%- if product.tags contains 'top' -%}
            {% render 'badge', variant: 'top', label: '★ Top ventas' %}
          {%- endif -%}
        </div>

        <div class="py-2" id="product-price-block">
          {% render 'price', product: product, size: 'lg' %}
          <p class="text-xs text-ink-muted mt-1 inline-flex items-center gap-1">
            {% render 'icon', name: 'credit-card', size: 12 %}
            Mercado Pago · Transferencia · Efectivo en tienda
          </p>
        </div>

        <p id="product-stock-status" class="text-sm font-semibold inline-flex items-center gap-2 {% if product.available %}text-success{% else %}text-danger{% endif %}">
          <span id="product-stock-dot" class="w-2 h-2 rounded-full {% if product.available %}bg-success{% else %}bg-danger{% endif %}"></span>
          <span id="product-stock-text">
            {%- if product.available -%}
              En stock · despacho según disponibilidad (consulta tiempos en checkout)
            {%- else -%}
              Agotado por ahora · pregúntanos cuándo vuelve
            {%- endif -%}
          </span>
        </p>

        {%- if section.settings.show_key_specs and section.blocks.size > 0 -%}
          <div class="nt-key-specs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'key_spec' -%}
                <div class="nt-key-spec" {{ block.shopify_attributes }}>
                  <span class="nt-key-spec__icon">
                    {% render 'icon', name: block.settings.icon, size: 18 %}
                  </span>
                  <span>
                    <span class="nt-key-spec__label">{{ block.settings.label }}</span>
                    <span class="nt-key-spec__value">{{ block.settings.value }}</span>
                  </span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {% render 'product-form', product: product %}

        {% render 'trust-badges' %}

        {% render 'payment-icons' %}
      </div>
    </div>

    <div class="grid lg:grid-cols-[1fr_320px] gap-8 max-w-6xl">
      <div class="space-y-0 border-t border-line" x-data="{ open: 1 }">
        <div class="border-b border-line py-6" :data-open="open === 1 ? true : null">
          <button
            type="button"
            class="nt-accordion__trigger"
            @click="open = open === 1 ? null : 1"
            :aria-expanded="open === 1"
          >
            <span class="text-base lg:text-lg font-semibold text-ink">{{ 'product.description' | t }}</span>
            <span class="nt-accordion__icon">{% render 'icon', name: 'chevron', size: 18 %}</span>
          </button>
          <div class="nt-accordion__content rte" x-show="open === 1" x-collapse x-cloak>
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>Producto con respaldo NANOTRONICS. Factura cuando aplica y soporte por WhatsApp en horario de tienda.</p>
            {%- endif -%}
          </div>
        </div>

        <div class="border-b border-line">
          <button
            type="button"
            class="nt-accordion__trigger"
            @click="open = open === 2 ? null : 2"
            :aria-expanded="open === 2"
          >
            <span class="text-base lg:text-lg font-semibold text-ink inline-flex items-center gap-2">
              {% render 'icon', name: 'cpu', size: 18, class: 'text-brand-royal' %}
              {{ 'product.specs' | t }}
            </span>
            <span class="nt-accordion__icon">{% render 'icon', name: 'chevron', size: 18 %}</span>
          </button>
          <div class="nt-accordion__content" x-show="open === 2" x-collapse x-cloak>
            {%- if section.settings.specs != blank -%}
              <div class="rte">{{ section.settings.specs }}</div>
            {%- else -%}
              <table class="w-full text-sm">
                <tbody class="divide-y divide-line">
                  {%- if product.metafields.specs.processor -%}<tr><td class="py-2 text-ink-muted">Procesador</td><td class="py-2 font-medium text-ink">{{ product.metafields.specs.processor }}</td></tr>{%- endif -%}
                  {%- if product.metafields.specs.ram -%}<tr><td class="py-2 text-ink-muted">RAM</td><td class="py-2 font-medium text-ink">{{ product.metafields.specs.ram }}</td></tr>{%- endif -%}
                  {%- if product.metafields.specs.storage -%}<tr><td class="py-2 text-ink-muted">Almacenamiento</td><td class="py-2 font-medium text-ink">{{ product.metafields.specs.storage }}</td></tr>{%- endif -%}
                  {%- if product.metafields.specs.gpu -%}<tr><td class="py-2 text-ink-muted">GPU</td><td class="py-2 font-medium text-ink">{{ product.metafields.specs.gpu }}</td></tr>{%- endif -%}
                  {%- if product.metafields.specs.display -%}<tr><td class="py-2 text-ink-muted">Pantalla</td><td class="py-2 font-medium text-ink">{{ product.metafields.specs.display }}</td></tr>{%- endif -%}
                  {%- if product.metafields.specs.os -%}<tr><td class="py-2 text-ink-muted">Sistema</td><td class="py-2 font-medium text-ink">{{ product.metafields.specs.os }}</td></tr>{%- endif -%}
                </tbody>
              </table>
              <p class="text-xs text-ink-muted mt-3">Configura las especificaciones desde los metafields del producto en Shopify Admin.</p>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.video_url != blank -%}
          <div class="border-b border-line">
            <button
              type="button"
              class="nt-accordion__trigger"
              @click="open = open === 3 ? null : 3"
              :aria-expanded="open === 3"
            >
              <span class="text-base lg:text-lg font-semibold text-ink inline-flex items-center gap-2">
                {% render 'icon', name: 'play', size: 16, class: 'text-brand-royal' %}
                Video del producto
              </span>
              <span class="nt-accordion__icon">{% render 'icon', name: 'chevron', size: 18 %}</span>
            </button>
            <div class="nt-accordion__content" x-show="open === 3" x-collapse x-cloak>
              <div class="aspect-video rounded-lg overflow-hidden bg-ink">
                <iframe
                  src="{{ section.settings.video_url }}"
                  loading="lazy"
                  class="w-full h-full"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  title="Video {{ product.title | escape }}"
                ></iframe>
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="border-b border-line">
          <button
            type="button"
            class="nt-accordion__trigger"
            @click="open = open === 4 ? null : 4"
            :aria-expanded="open === 4"
          >
            <span class="text-base lg:text-lg font-semibold text-ink">{{ 'product.faq' | t }}</span>
            <span class="nt-accordion__icon">{% render 'icon', name: 'chevron', size: 18 %}</span>
          </button>
          <div class="nt-accordion__content space-y-5" x-show="open === 4" x-collapse x-cloak>
            <div>
              <p class="font-semibold text-ink mb-1">¿Cuánto tarda el envío?</p>
              <p>Despachamos el mismo día si compras antes de las {{ shipping_cutoff }}. Medellín y área metro: {{ shipping_medellin }}. Resto de Colombia: {{ shipping_national }}.</p>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">¿Qué garantía tiene?</p>
              <p>{{ product_warranty }}</p>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">¿Puedo pagar a cuotas?</p>
              <p>Mercado Pago en la tienda online, transferencia bancaria y efectivo en nuestra tienda del Parque Principal. Las cuotas dependen del medio que elijas en checkout.</p>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">¿Puedo recoger en tienda?</p>
              <p>Sí, sin costo. Te avisamos por WhatsApp cuando esté listo. Horario: {{ settings.store_hours }}.</p>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">¿Es producto nuevo y original?</p>
              <p>Productos nuevos con factura cuando aplica. Trabajamos con marcas de nuestro catálogo oficial; si tienes dudas sobre un modelo, escríbenos antes de comprar.</p>
            </div>
          </div>
        </div>

        <div class="border-b border-line">
          <button
            type="button"
            class="nt-accordion__trigger"
            @click="open = open === 5 ? null : 5"
            :aria-expanded="open === 5"
          >
            <span class="text-base lg:text-lg font-semibold text-ink inline-flex items-center gap-2">
              {% render 'icon', name: 'star', size: 18, class: 'text-warning fill-warning' %}
              Calificación en Google
            </span>
            <span class="nt-accordion__icon">{% render 'icon', name: 'chevron', size: 18 %}</span>
          </button>
          <div class="nt-accordion__content" x-show="open === 5" x-collapse x-cloak>
            <p class="text-ink-muted mb-3">
              Promedio {{ settings.metric_rating_value | default: '4.3★' }} en Google Maps (tienda física).
              Las reseñas las consultas directamente en Google — no publicamos testimonios inventados en este sitio.
            </p>
            <a
              href="{% render 'google-maps-href', kind: 'place' %}"
              target="_blank"
              rel="noopener"
              class="text-brand-royal text-sm font-medium hover:underline inline-flex items-center gap-1 mb-3"
            >
              Ver reseñas en Google Maps {% render 'icon', name: 'arrow-right', size: 12 %}
            </a>
            <p class="text-sm text-ink-muted">¿Dudas sobre este producto?</p>
            <a href="{{ wa_product_url }}" target="_blank" rel="noopener" class="text-brand-royal text-sm font-medium hover:underline inline-flex items-center gap-1 mt-1">
              Escríbenos por WhatsApp {% render 'icon', name: 'arrow-right', size: 12 %}
            </a>
          </div>
        </div>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-32 lg:self-start">
        <div class="nt-card p-5 space-y-3">
          <p class="font-semibold text-sm text-ink inline-flex items-center gap-2">
            {% render 'icon', name: 'headset', size: 16, class: 'text-brand-royal' %}
            ¿Dudas antes de comprar?
          </p>
          <p class="text-xs text-ink-muted leading-relaxed">Te ayudamos a elegir el equipo correcto según tu uso, presupuesto y dónde lo usarás. Sin presión.</p>
          {% render 'btn',
            variant: 'whatsapp',
            size: 'md',
            label: 'Asesoría gratis por WhatsApp',
            icon: 'whatsapp',
            href: wa_product_url,
            target: '_blank',
            full: true
          %}
          <a href="tel:{{ settings.store_phone | replace: ' ', '' }}" class="block text-sm text-center text-brand-royal hover:underline">
            o llámanos: {{ settings.store_phone }}
          </a>
        </div>

        <div class="nt-card p-5 space-y-2">
          <p class="font-semibold text-sm text-ink inline-flex items-center gap-2">
            {% render 'icon', name: 'tool', size: 16, class: 'text-brand-royal' %}
            ¿Lo necesitas armado?
          </p>
          <p class="text-xs text-ink-muted leading-relaxed">Lo configuramos, instalamos Windows y drivers para que llegue listo a usar.</p>
          <a href="/pages/servicio-tecnico" class="text-sm text-brand-royal font-medium hover:underline inline-flex items-center gap-1">
            Ver servicios {% render 'icon', name: 'arrow-right', size: 12 %}
          </a>
        </div>

        <div class="nt-card p-5 space-y-2 bg-brand-deep text-white border-brand-deep">
          <p class="font-semibold text-sm inline-flex items-center gap-2">
            {% render 'icon', name: 'map-pin', size: 16 %}
            Recoge en tienda
          </p>
          <p class="text-xs text-white/75">{{ settings.store_address }}</p>
          <p class="text-xs text-white/75">{{ settings.store_hours }}</p>
          <p class="text-xs text-white/55">Sin costo · te avisamos por WhatsApp</p>
        </div>
      </aside>
    </div>

    {%- if product.collections.size > 0 -%}
      {%- assign related_col = product.collections.first -%}
      <div class="mt-16">
        <div class="flex items-end justify-between gap-4 mb-6">
          <div>
            <p class="nt-eyebrow mb-1">Completa tu setup</p>
            <h2 class="nt-section-title mb-0">{{ 'product.related' | t }}</h2>
          </div>
          <a href="{{ related_col.url }}" class="text-sm font-medium text-brand-royal hover:underline shrink-0 inline-flex items-center gap-1">
            Ver toda la categoría {% render 'icon', name: 'arrow-right', size: 14 %}
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {%- assign shown = 0 -%}
          {%- for related in related_col.products -%}
            {%- if related.id != product.id and shown < 4 -%}
              {% render 'product-card', product: related %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- capture add_label -%}{{ 'general.add_to_cart' | t }}{%- endcapture -%}
<div class="nt-sticky-bar pb-safe lg:hidden">
  <div class="flex gap-2 max-w-lg mx-auto items-center">
    <div class="text-xs" id="sticky-product-price">
      <p class="font-bold text-ink" data-price-current>{{ product.price | money }}</p>
      {%- if product.compare_at_price > product.price -%}
        <p class="text-[10px] text-danger font-semibold">Oferta</p>
      {%- endif -%}
    </div>
    <a href="{{ wa_product_url }}" class="nt-btn nt-btn--whatsapp nt-btn--md shrink-0" target="_blank" rel="noopener" aria-label="WhatsApp">
      {% render 'icon', name: 'whatsapp', size: 20 %}
    </a>
    <button type="submit" form="product-form" class="nt-btn nt-btn--primary nt-btn--md flex-1" {% unless product.available %}disabled{% endunless %}>
      {% render 'icon', name: 'cart', size: 16 %}
      {{ add_label }}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "checkbox", "id": "show_key_specs", "label": "Mostrar specs destacadas", "default": true },
    { "type": "richtext", "id": "specs", "label": "Especificaciones (HTML)", "default": "<p>Configura los metafields specs.processor / specs.ram / specs.storage / specs.gpu / specs.display / specs.os para mostrar las especificaciones en formato tabla.</p>" },
    { "type": "url", "id": "video_url", "label": "URL embed video (YouTube/Vimeo)" }
  ],
  "blocks": [
    {
      "type": "key_spec",
      "name": "Spec destacada",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícono", "default": "cpu", "options": [
          { "value": "cpu", "label": "Procesador" },
          { "value": "monitor", "label": "Pantalla" },
          { "value": "package", "label": "RAM" },
          { "value": "zap", "label": "Velocidad" },
          { "value": "gauge", "label": "Rendimiento" }
        ] },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Procesador" },
        { "type": "text", "id": "value", "label": "Valor", "default": "Intel Core i7" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Producto premium",
      "blocks": [
        { "type": "key_spec", "settings": { "icon": "cpu", "label": "Procesador", "value": "Intel Core i7" } },
        { "type": "key_spec", "settings": { "icon": "package", "label": "RAM", "value": "16GB DDR5" } },
        { "type": "key_spec", "settings": { "icon": "zap", "label": "Almacenamiento", "value": "512GB SSD" } },
        { "type": "key_spec", "settings": { "icon": "monitor", "label": "Pantalla", "value": "15.6\" FHD" } }
      ]
    }
  ]
}
{% endschema %}
