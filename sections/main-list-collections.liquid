<section class="nt-section">
  <div class="nt-container">
    {% render 'breadcrumbs' %}

    <div class="mb-10">
      <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow | default: 'Catálogo NANOTRONICS' }}</p>
      <h1 style="font-size: var(--text-h1)" class="font-bold tracking-tight text-ink mb-2">{{ section.settings.title }}</h1>
      {%- if section.settings.description != blank -%}
        <p class="text-ink-muted max-w-2xl">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- liquid
      assign handles_source = settings.nav_collection_handles | default: ''
      if handles_source == blank
        assign handles_source = 'catalogo-destacado|accesorios|cables|power-bank|parlantes|diademas|belleza'
        assign handles_lines = handles_source | split: '|'
      else
        assign handles_lines = handles_source | newline_to_br | split: '<br />'
      endif
      assign shown = 0
    -%}

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {%- for line in handles_lines -%}
        {%- assign handle = line | strip -%}
        {%- if handle != blank and handle != 'frontpage' -%}
          {%- assign col = collections[handle] -%}
          {%- assign card_url = col.url -%}
          {%- assign card_title = col.title -%}
          {%- assign card_image = col.image -%}
          {%- if card_url == blank -%}
            {%- assign card_url = routes.collections_url | append: '/' | append: handle -%}
          {%- endif -%}
          {%- if card_title == blank -%}
            {%- assign card_title = handle | replace: '-', ' ' | capitalize -%}
          {%- endif -%}
          {%- if col != blank and col.products_count > 0 -%}
            {%- assign eyebrow_text = col.products_count | append: ' productos' -%}
          {%- else -%}
            {%- assign eyebrow_text = '' -%}
          {%- endif -%}
          {%- capture theme_data -%}{% render 'category-theme', handle: handle, title: card_title, icon: 'grid' %}{%- endcapture -%}
          {%- assign theme_parts = theme_data | strip | split: '|' -%}
          {%- assign card_image_asset = theme_parts | first -%}
          {%- assign card_icon = theme_parts | last -%}
          {%- if card_image != blank -%}
            {%- assign card_image_asset = '' -%}
          {%- endif -%}
          <div>
            {% render 'category-card',
              title: card_title,
              url: card_url,
              image: card_image,
              image_asset: card_image_asset,
              icon: card_icon,
              eyebrow: eyebrow_text
            %}
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if shown == 0 -%}
      <div class="text-center py-16 nt-card">
        <p class="text-ink-muted mb-4">Aún no hay colecciones visibles en la tienda online.</p>
        {% render 'btn', variant: 'primary', size: 'lg', label: 'Ver todo el catálogo', href: routes.all_products_collection_url, icon: 'arrow-right' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Listado de colecciones",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explora por categoría" },
    { "type": "text", "id": "title", "label": "Título", "default": "Todas las categorías" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Accesorios, audio, cables, belleza y más. Compra online o recoge en el Parque Principal de El Carmen de Viboral."
    }
  ]
}
{% endschema %}
