{%- liquid
  assign story_html = section.settings.story
  if story_html == blank and settings.brand_story_short != blank
    assign story_html = settings.brand_story_short | newline_to_br
  endif
  assign mission_text = section.settings.mission | default: settings.brand_mission
  assign values_source = section.settings.values
  if values_source == blank
    assign values_source = settings.brand_values
  endif
-%}

{% render 'breadcrumbs' %}

<section class="nt-section pt-0">
  <div class="nt-container">
    <div class="relative overflow-hidden rounded-2xl bg-brand-deep text-white p-6 md:p-12 mb-12">
      <div class="absolute inset-0 nt-tech-grid opacity-25 pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl">
        <p class="nt-eyebrow !text-brand-glow mb-2">{{ settings.brand_tagline | default: 'Al son de la tecnología' }}</p>
        <h1 style="font-size: var(--text-h1)" class="font-bold tracking-tight mb-5">
          {{ section.settings.heading | default: page.title }}
        </h1>
        <div class="prose prose-invert prose-sm max-w-none text-white/80 rte leading-relaxed">
          {%- if section.settings.story != blank -%}
            {{ section.settings.story }}
          {%- else -%}
            {{ settings.brand_story_short | newline_to_br }}
          {%- endif -%}
        </div>

        <div class="grid sm:grid-cols-3 gap-6 mt-8 pt-8 border-t border-white/10">
          <div>
            <p class="text-3xl font-bold tracking-tight">{{ settings.metric_clients_value }}</p>
            <p class="text-sm text-white/65">{{ settings.metric_clients_label }}</p>
          </div>
          <div>
            <p class="text-3xl font-bold tracking-tight">{{ settings.metric_years_value }}</p>
            <p class="text-sm text-white/65">{{ settings.metric_years_label }}</p>
          </div>
          <div>
            <p class="text-3xl font-bold tracking-tight">{{ settings.metric_rating_value }}</p>
            <p class="text-sm text-white/65">{{ settings.metric_rating_label }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 mb-16 items-center">
      {%- if section.settings.store_image != blank -%}
        <div class="rounded-xl overflow-hidden aspect-[4/3] shadow-md">
          {{ section.settings.store_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: 'Tienda NANOTRONICS' }}
        </div>
      {%- else -%}
        <div class="rounded-xl bg-gradient-to-br from-brand-royal to-brand-deep aspect-[4/3] flex items-center justify-center text-white/30">
          {% render 'icon', name: 'map-pin', size: 80 %}
        </div>
      {%- endif -%}
      <div class="space-y-6">
        <div>
          <p class="nt-eyebrow mb-2">Lo que nos mueve</p>
          <h2 class="text-h3 font-semibold mb-3 inline-flex items-center gap-2">
            {% render 'icon', name: 'sparkle', size: 20, class: 'text-brand-royal' %}
            {{ 'about.mission' | t }}
          </h2>
          <p class="text-ink-muted leading-relaxed">{{ mission_text }}</p>
        </div>
        <div>
          <h2 class="text-h3 font-semibold mb-3 inline-flex items-center gap-2">
            {% render 'icon', name: 'award', size: 20, class: 'text-brand-royal' %}
            {{ 'about.values' | t }}
          </h2>
          <ul class="grid sm:grid-cols-2 gap-2">
            {%- assign values_list = values_source | newline_to_br | split: '<br />' -%}
            {%- for value in values_list -%}
              <li class="flex items-center gap-2 text-sm text-ink-muted">
                {% render 'icon', name: 'check-circle', size: 16, class: 'text-success shrink-0' %}
                {{ value | strip }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-lg bg-brand-sky border border-brand-electric/20">
          {% render 'icon', name: 'map-pin', size: 22, class: 'text-brand-royal shrink-0 mt-0.5' %}
          <div class="text-sm">
            <p class="font-semibold text-ink">Visítanos en El Carmen de Viboral</p>
            <p class="text-ink-muted">{{ settings.store_street_address | default: settings.store_address }}</p>
            <p class="text-ink-muted">{{ settings.store_hours }}</p>
            <p class="text-xs text-ink-muted mt-1">NIT {{ settings.store_nit }} · Empresa legalmente constituida</p>
          </div>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mb-16">
      <div class="nt-card p-6 text-center">
        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-brand-sky text-brand-royal mx-auto mb-3">
          {% render 'icon', name: 'tag', size: 22 %}
        </span>
        <p class="font-bold text-ink mb-1">{{ settings.brand_usp_1 | default: 'Buen precio' }}</p>
        <p class="text-sm text-ink-muted">Relación costo-beneficio competitiva en la región.</p>
      </div>
      <div class="nt-card p-6 text-center">
        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-brand-sky text-brand-royal mx-auto mb-3">
          {% render 'icon', name: 'package', size: 22 %}
        </span>
        <p class="font-bold text-ink mb-1">{{ settings.brand_usp_2 | default: 'Amplia variedad' }}</p>
        <p class="text-sm text-ink-muted">Tecnología, accesorios, audio, belleza y cables en un solo lugar.</p>
      </div>
      <div class="nt-card p-6 text-center">
        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-brand-sky text-brand-royal mx-auto mb-3">
          {% render 'icon', name: 'headset', size: 22 %}
        </span>
        <p class="font-bold text-ink mb-1">{{ settings.brand_usp_3 | default: 'Excelente atención' }}</p>
        <p class="text-sm text-ink-muted">WhatsApp con respuesta en ~5 min en horario de tienda.</p>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="text-center mb-10">
        <p class="nt-eyebrow mb-2">Nuestro equipo</p>
        <h2 class="nt-section-title text-center">Quienes te atienden</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-16">
        {%- for block in section.blocks -%}
          <div class="text-center p-6 rounded-xl border border-line bg-surface" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 240 | image_tag: class: 'w-24 h-24 rounded-full object-cover mx-auto mb-4', alt: block.settings.name, loading: 'lazy' }}
            {%- else -%}
              <div class="w-24 h-24 rounded-full bg-gradient-to-br from-brand-royal to-brand-electric mx-auto mb-4 flex items-center justify-center text-white font-bold text-2xl">
                {{ block.settings.name | slice: 0 }}
              </div>
            {%- endif -%}
            <p class="font-semibold text-ink">{{ block.settings.name }}</p>
            <p class="text-sm text-brand-royal">{{ block.settings.role }}</p>
            {%- if block.settings.bio != blank -%}
              <p class="text-xs text-ink-muted mt-2">{{ block.settings.bio }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="nt-card p-6 md:p-8 text-center max-w-2xl mx-auto mb-16">
        <p class="nt-eyebrow mb-2">Equipo</p>
        <h2 class="text-xl font-bold text-ink mb-2">5 personas, una sola tienda</h2>
        <p class="text-sm text-ink-muted leading-relaxed">
          Somos un equipo pequeño y cercano en el Parque Principal. Cuando nos escribes o visitas la tienda, te atiende gente real — no un call center.
        </p>
      </div>
    {%- endif -%}

    <div class="relative overflow-hidden rounded-2xl bg-brand-deep text-white p-6 md:p-10 text-center">
      <div class="absolute inset-0 nt-tech-grid opacity-20 pointer-events-none"></div>
      <div class="relative z-10 max-w-xl mx-auto space-y-4">
        <h2 class="text-2xl font-bold">¿Listo para visitarnos o escribirnos?</h2>
        <p class="text-white/75 text-sm">Horario: {{ settings.store_hours }}</p>
        {%- liquid
          assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
          assign wa_text = settings.whatsapp_message | url_encode
          assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
        -%}
        <div class="flex flex-wrap justify-center gap-3">
          {% render 'btn', variant: 'whatsapp', size: 'lg', label: 'WhatsApp', icon: 'whatsapp', href: wa_url, target: '_blank' %}
          {% render 'btn', variant: 'secondary', size: 'lg', label: 'Ver catálogo', href: '/collections/all', class: '!bg-white/10 !text-white !border-white/20' %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nosotros",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Desde 2005 en el Parque Principal" },
    { "type": "richtext", "id": "story", "label": "Historia", "default": "<p>NANOTRONICS nació en 2005 como tienda y servicio técnico en El Carmen de Viboral. Alpidio Betancur fundó un negocio para acercar la tecnología al oriente antioqueño; hoy Juan Pablo Betancur continúa esa visión.</p><p>Somos principalmente tienda — con amplia variedad en accesorios, audio, belleza, cables y tecnología — y mantenemos taller para cuando tu equipo necesita reparación o mantenimiento.</p><p>Nos distinguen el buen precio, la variedad y una atención que genera confianza. Por eso muchos clientes nos eligen por la inmediatez: saben que respondemos.</p>" },
    { "type": "textarea", "id": "mission", "label": "Misión", "default": "Acercar tecnología y soluciones confiables al oriente antioqueño, con precios justos, variedad real y un servicio que responde cuando lo necesitas." },
    { "type": "textarea", "id": "values", "label": "Valores (uno por línea)", "default": "Precio justo y transparente\nVariedad para resolver en un solo lugar\nAtención rápida y humana\nCompromiso con El Carmen de Viboral\nServicio técnico cuando el equipo falla\nConfianza desde 2005" },
    { "type": "image_picker", "id": "store_image", "label": "Foto tienda física" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Miembro del equipo",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Equipo NANOTRONICS" },
        { "type": "text", "id": "role", "label": "Cargo", "default": "Técnico especialista" },
        { "type": "textarea", "id": "bio", "label": "Bio corta" },
        { "type": "image_picker", "id": "photo", "label": "Foto" }
      ]
    }
  ],
  "presets": [{ "name": "Nosotros" }]
}
{% endschema %}
