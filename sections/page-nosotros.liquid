{% render 'breadcrumbs' %}

<section class="nt-section pt-0">
  <div class="nt-container max-w-4xl">
    <h1 style="font-size: var(--text-h1)" class="font-bold tracking-tight text-brand-deep mb-6">
      {{ section.settings.heading | default: page.title }}
    </h1>

    <div class="prose prose-sm max-w-none text-ink-muted mb-12 rte">
      {{ section.settings.story }}
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      {%- if section.settings.store_image != blank -%}
        <div class="rounded-lg overflow-hidden aspect-[4/3]">
          {{ section.settings.store_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: 'Tienda NANOTRONICS' }}
        </div>
      {%- endif -%}
      <div class="space-y-6">
        <div>
          <h2 class="text-h4 font-semibold mb-2">{{ 'about.mission' | t }}</h2>
          <p class="text-sm text-ink-muted">{{ section.settings.mission }}</p>
        </div>
        <div>
          <h2 class="text-h4 font-semibold mb-2">{{ 'about.values' | t }}</h2>
          <ul class="text-sm text-ink-muted space-y-2 list-disc pl-5">
            {%- assign values_list = section.settings.values | newline_to_br | split: '<br />' -%}
            {%- for value in values_list -%}
              <li>{{ value | strip }}</li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="flex items-start gap-3 text-sm">
          {% render 'icon', name: 'map-pin', size: 20, class: 'text-brand-royal shrink-0 mt-0.5' %}
          <div>
            <p class="font-medium text-ink">{{ settings.store_address }}</p>
            <p class="text-ink-muted">NIT {{ settings.store_nit }}</p>
          </div>
        </div>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <h2 class="nt-section-title">{{ 'about.team' | t }}</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        {%- for block in section.blocks -%}
          <div class="text-center p-6 rounded-lg border border-line" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 200 | image_tag: class: 'w-24 h-24 rounded-full object-cover mx-auto mb-4', alt: block.settings.name }}
            {%- else -%}
              <div class="w-24 h-24 rounded-full bg-brand-royal/10 mx-auto mb-4 flex items-center justify-center text-brand-royal font-bold text-xl">
                {{ block.settings.name | slice: 0 }}
              </div>
            {%- endif -%}
            <p class="font-semibold">{{ block.settings.name }}</p>
            <p class="text-sm text-ink-muted">{{ block.settings.role }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Nosotros",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Sobre NANOTRONICS" },
    { "type": "richtext", "id": "story", "label": "Historia", "default": "<p>Somos la tienda tecnológica de confianza en el oriente antioqueño. Desde El Carmen de Viboral, ofrecemos equipos de calidad, asesoría honesta y servicio técnico especializado.</p>" },
    { "type": "textarea", "id": "mission", "label": "Misión", "default": "Impulsar el rendimiento de gamers, estudiantes y profesionales con tecnología de calidad y soporte cercano." },
    { "type": "textarea", "id": "values", "label": "Valores (uno por línea)", "default": "Honestidad\nCalidad\nServicio\nCompromiso local" },
    { "type": "image_picker", "id": "store_image", "label": "Foto tienda física" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Miembro del equipo",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Equipo NANOTRONICS" },
        { "type": "text", "id": "role", "label": "Cargo", "default": "Técnico especialista" },
        { "type": "image_picker", "id": "photo", "label": "Foto" }
      ]
    }
  ],
  "presets": [{ "name": "Nosotros" }]
}
{% endschema %}
