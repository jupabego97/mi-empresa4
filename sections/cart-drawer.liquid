{%- capture checkout_label -%}{{ 'cart.checkout' | t }}{%- endcapture -%}
<div
  id="cart-drawer"
  class="nt-drawer"
  :class="{ 'is-open': cartOpen }"
  x-cloak
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.title' | t }}"
>
  <div class="nt-drawer__backdrop" @click="cartOpen = false; window.dispatchEvent(new CustomEvent('close-cart'))"></div>
  <div class="nt-drawer__panel">
    <div class="flex items-center justify-between p-4 border-b border-line" id="cart-drawer-header">
      <h2 class="text-lg font-semibold inline-flex items-center gap-2">
        {% render 'icon', name: 'cart', size: 20, class: 'text-brand-royal' %}
        {{ 'cart.title' | t }}
        <span class="text-sm font-normal text-ink-muted" id="cart-drawer-count">({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="nt-header__icon-btn" @click="cartOpen = false; window.dispatchEvent(new CustomEvent('close-cart'))" aria-label="{{ 'cart.close' | t }}">
        {% render 'icon', name: 'x', size: 22 %}
      </button>
    </div>

    <div id="cart-drawer-shipping" class="{% if cart.item_count == 0 %}hidden{% endif %}">
      {%- if cart.item_count > 0 -%}
        <div class="px-4 pt-4">
          {% render 'shipping-progress' %}
        </div>
      {%- endif -%}
    </div>

    <div class="flex-1 overflow-y-auto p-4" id="cart-drawer-items">
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          {% render 'cart-line-item', item: item %}
        {%- endfor -%}
      {%- else -%}
        <div class="text-center py-12">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-sky text-brand-royal mb-4">
            {% render 'icon', name: 'cart', size: 32 %}
          </div>
          <p class="font-semibold mb-1">Tu carrito está vacío</p>
          <p class="text-sm text-ink-muted mb-6">Empieza a explorar y arma tu setup ideal</p>
          {% render 'btn', variant: 'primary', size: 'md', label: 'Explorar catálogo', href: routes.all_products_collection_url %}
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="p-4 border-t border-line space-y-3" id="cart-drawer-footer">
        <div class="flex justify-between items-baseline">
          <span class="text-ink-muted text-sm">{{ 'cart.subtotal' | t }}</span>
          <span class="font-bold text-xl">{{ cart.total_price | money }}</span>
        </div>
        <p class="text-xs text-ink-muted">{{ 'cart.checkout_note' | t }}</p>
        {% render 'payment-icons' %}
        <form action="{{ routes.cart_url }}" method="post" novalidate class="contents">
          <button type="submit" name="checkout" class="nt-btn nt-btn--primary nt-btn--lg nt-btn--full">
            {% render 'icon', name: 'shield-check', size: 18 %}
            {{ checkout_label }}
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="block text-center text-sm text-brand-royal hover:underline">
          {{ 'cart.view_cart' | t }}
        </a>
      </div>
    {%- else -%}
      <div id="cart-drawer-footer" class="hidden" aria-hidden="true"></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
