{%- capture checkout_label -%}{{ 'cart.checkout' | t }}{%- endcapture -%}
<div
  id="cart-drawer"
  class="nt-drawer"
  :class="{ 'is-open': cartOpen }"
  x-cloak
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.title' | t }}"
>
  <div class="nt-drawer__backdrop" @click="cartOpen = false"></div>
  <div class="nt-drawer__panel">
    <div class="flex items-center justify-between p-4 border-b border-line">
      <h2 class="text-lg font-semibold">{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="nt-header__icon-btn" @click="cartOpen = false" aria-label="{{ 'cart.close' | t }}">
        {% render 'icon', name: 'x', size: 22 %}
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4" id="cart-drawer-items">
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          {% render 'cart-line-item', item: item %}
        {%- endfor -%}
      {%- else -%}
        <p class="text-center text-ink-muted py-12">{{ 'cart.empty' | t }}</p>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="p-4 border-t border-line space-y-4">
        <div class="flex justify-between text-sm">
          <span class="text-ink-muted">{{ 'cart.subtotal' | t }}</span>
          <span class="font-bold text-lg">{{ cart.total_price | money }}</span>
        </div>
        {% render 'payment-icons' %}
        {% render 'btn', variant: 'primary', size: 'lg', label: checkout_label, href: '/checkout', class: 'w-full', full: true %}
        <a href="{{ routes.cart_url }}" class="block text-center text-sm text-brand-royal hover:underline">{{ 'cart.view_cart' | t }}</a>
        <p class="text-xs text-center text-ink-muted">{{ 'cart.checkout_note' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
