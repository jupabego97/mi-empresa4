<section class="nt-section">
  <div class="nt-container">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow | default: 'Reseñas de clientes reales' }}</p>
      <h2 class="nt-section-title text-center mb-2">{{ section.settings.title }}</h2>
      <p class="text-ink-muted">{{ section.settings.description }}</p>
      <div class="inline-flex items-center gap-2 mt-4">
        <span class="inline-flex items-center gap-0.5" aria-hidden="true">
          {%- for i in (1..4) -%}
            {% render 'icon', name: 'star', size: 16, class: 'text-warning fill-warning' %}
          {%- endfor -%}
          {% render 'icon', name: 'star', size: 16, class: 'text-warning/35' %}
        </span>
        <span class="text-sm font-bold text-ink">{{ settings.metric_rating_value | default: '4.3★' }}</span>
        <a href="https://www.google.com/maps/search/?api=1&query=NANOTRONICS+El+Carmen+de+Viboral" target="_blank" rel="noopener" class="text-sm text-brand-royal hover:underline">Google Maps</a>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {% render 'review-card',
            quote: block.settings.quote,
            author: block.settings.author,
            location: block.settings.location,
            rating: block.settings.rating,
            avatar: block.settings.avatar,
            product: block.settings.product
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Reseñas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reseñas de clientes reales" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que dicen en Google" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "4.3★ de calificación promedio. Confianza construida desde 2005 en el oriente antioqueño." },
    { "type": "text", "id": "review_count", "label": "Total reseñas (visual)", "default": "" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Testimonio", "default": "Excelente servicio y productos de calidad." },
        { "type": "text", "id": "author", "label": "Nombre", "default": "Cliente" },
        { "type": "text", "id": "location", "label": "Ubicación", "default": "Rionegro, Antioquia" },
        { "type": "text", "id": "product", "label": "Producto comprado (opcional)", "default": "" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "default": 5, "label": "Estrellas" },
        { "type": "image_picker", "id": "avatar", "label": "Foto (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home — Reseñas",
      "blocks": [
        { "type": "review", "settings": { "quote": "Buena atención y variedad de accesorios. Siempre encuentro lo que busco en el centro.", "author": "Cliente verificado", "location": "El Carmen de Viboral", "rating": 5 } },
        { "type": "review", "settings": { "quote": "Me arreglaron el portátil y me explicaron el problema antes de cobrar. Precio justo.", "author": "Cliente verificado", "location": "Rionegro, Antioquia", "product": "Servicio técnico", "rating": 4 } },
        { "type": "review", "settings": { "quote": "Tienda de confianza en Viboral. Responden rápido por WhatsApp.", "author": "Cliente verificado", "location": "La Ceja, Antioquia", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
