{%- liquid
  assign rating_text = settings.metric_rating_value | default: '4.3★'
  assign rating_num = rating_text | remove: '★' | replace: ',', '.' | strip | plus: 0
  assign rating_full = rating_num | floor
  if rating_full > 5
    assign rating_full = 5
  endif
  assign rating_empty = 5 | minus: rating_full
-%}
{%- capture reviews_href -%}{% render 'google-maps-href', kind: 'place' %}{%- endcapture -%}
<section class="nt-section">
  <div class="nt-container">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow | default: 'Opiniones en Google' }}</p>
      <h2 class="nt-section-title text-center mb-2">{{ section.settings.title }}</h2>
      <p class="text-ink-muted">{{ section.settings.description }}</p>
      <div class="inline-flex items-center gap-2 mt-4">
        <span class="inline-flex items-center gap-0.5" aria-hidden="true">
          {%- for i in (1..rating_full) -%}
            {% render 'icon', name: 'star', size: 16, class: 'text-warning fill-warning' %}
          {%- endfor -%}
          {%- if rating_empty > 0 -%}
            {%- for i in (1..rating_empty) -%}
              {% render 'icon', name: 'star', size: 16, class: 'text-warning/35' %}
            {%- endfor -%}
          {%- endif -%}
        </span>
        <span class="text-sm font-bold text-ink">{{ rating_text }}</span>
        {%- if section.settings.review_count != blank -%}
          <span class="text-sm text-ink-muted">· {{ section.settings.review_count }}</span>
        {%- endif -%}
      </div>
      {%- if section.blocks.size == 0 -%}
        <div class="mt-6">
          {% render 'btn', variant: 'secondary', size: 'lg', label: section.settings.cta_label, href: reviews_href, icon: 'arrow-right', target: '_blank', rel: 'noopener' %}
        </div>
      {%- else -%}
        <a href="{{ reviews_href }}" target="_blank" rel="noopener" class="inline-block mt-3 text-sm text-brand-royal hover:underline">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
    <div class="grid md:grid-cols-3 gap-6">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {% render 'review-card',
            quote: block.settings.quote,
            author: block.settings.author,
            location: block.settings.location,
            rating: block.settings.rating,
            avatar: block.settings.avatar,
            product: block.settings.product
          %}
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home — Reseñas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opiniones en Google" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que dicen en Google" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "4.3★ de calificación promedio. Confianza construida desde 2005 en el oriente antioqueño." },
    { "type": "text", "id": "review_count", "label": "Total reseñas (ej. 120 reseñas)" },
    { "type": "text", "id": "cta_label", "label": "Texto del enlace a Google", "default": "Leer reseñas en Google" },
    { "type": "paragraph", "content": "Añade como bloques solo reseñas reales copiadas de Google, con el nombre que aparece allí. Sin bloques se muestra la calificación y el enlace a Google." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Testimonio", "default": "Excelente servicio y productos de calidad." },
        { "type": "text", "id": "author", "label": "Nombre", "default": "Cliente" },
        { "type": "text", "id": "location", "label": "Ubicación", "default": "Rionegro, Antioquia" },
        { "type": "text", "id": "product", "label": "Producto comprado (opcional)" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "default": 5, "label": "Estrellas" },
        { "type": "image_picker", "id": "avatar", "label": "Foto (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Home — Reseñas" }]
}
{% endschema %}
