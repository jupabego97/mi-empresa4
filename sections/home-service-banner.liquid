{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_msg = settings.whatsapp_message_service | default: 'Hola, quiero solicitar servicio técnico para mi equipo'
  assign wa_text = wa_msg | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}
<section class="nt-section">
  <div class="nt-container">
    <div class="relative overflow-hidden rounded-2xl bg-brand-deep text-white p-6 md:p-10 lg:p-12 grid lg:grid-cols-[1.1fr_1fr] gap-8 items-center">
      <div class="absolute inset-0 nt-tech-grid opacity-30 pointer-events-none"></div>
      <div class="absolute -left-32 top-0 w-96 h-96 rounded-full bg-brand-electric/30 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-5">
        <span class="nt-hero__pill">
          {% render 'icon', name: 'tool', size: 14 %}
          <span>{{ section.settings.label | default: 'Taller técnico certificado' }}</span>
        </span>
        <h2 style="font-size: var(--text-h2)" class="font-bold tracking-tight leading-tight">
          {{ section.settings.heading }}
        </h2>
        <p class="text-white/75 max-w-xl">{{ section.settings.text }}</p>

        <ul class="grid sm:grid-cols-2 gap-2 text-sm text-white/85">
          <li class="flex items-start gap-2">
            {% render 'icon', name: 'check-circle', size: 16, class: 'text-brand-glow shrink-0 mt-0.5' %}
            <span>Diagnóstico (consultar costo)</span>
          </li>
          <li class="flex items-start gap-2">
            {% render 'icon', name: 'check-circle', size: 16, class: 'text-brand-glow shrink-0 mt-0.5' %}
            <span>Garantía sobre la reparación</span>
          </li>
          <li class="flex items-start gap-2">
            {% render 'icon', name: 'check-circle', size: 16, class: 'text-brand-glow shrink-0 mt-0.5' %}
            <span>Repuestos según disponibilidad</span>
          </li>
          <li class="flex items-start gap-2">
            {% render 'icon', name: 'check-circle', size: 16, class: 'text-brand-glow shrink-0 mt-0.5' %}
            <span>Tiempos según el servicio</span>
          </li>
        </ul>

        <div class="flex flex-wrap gap-3 pt-2">
          {% render 'btn',
            variant: 'whatsapp',
            size: 'lg',
            label: section.settings.cta,
            icon: 'whatsapp',
            href: wa_url,
            target: '_blank',
            rel: 'noopener'
          %}
          {% render 'btn',
            variant: 'secondary',
            size: 'lg',
            label: 'Ver servicios',
            href: '/pages/servicio-tecnico',
            class: '!bg-white/10 !text-white !border-white/20 hover:!bg-white/20'
          %}
        </div>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="relative z-10 rounded-xl overflow-hidden aspect-[4/3] lg:aspect-square shadow-modal">
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: section.settings.heading }}
        </div>
      {%- else -%}
        <div class="relative z-10 rounded-xl bg-white/5 border border-white/10 aspect-[4/3] lg:aspect-square flex items-center justify-center">
          {% render 'icon', name: 'tool', size: 80, class: 'text-white/40' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Servicio técnico",
  "settings": [
    { "type": "text", "id": "label", "label": "Etiqueta", "default": "Servicio técnico en tienda" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Tu equipo no está rindiendo? Lo revisamos en el taller." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Desde 2005 reparamos y mantenemos equipos en el Parque Principal. Cotización antes de reparar y 30 días de garantía en mano de obra." },
    { "type": "text", "id": "cta", "label": "CTA", "default": "Solicitar servicio por WhatsApp" },
    { "type": "image_picker", "id": "image", "label": "Imagen taller" }
  ],
  "presets": [{ "name": "Home — Servicio técnico" }]
}
{% endschema %}
