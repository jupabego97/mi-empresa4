{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_msg = 'Hola, quiero solicitar un diagnóstico de servicio técnico'
  assign wa_text = wa_msg | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}
<section class="nt-section">
  <div class="nt-container">
    <div class="relative overflow-hidden rounded-xl bg-brand-deep text-white p-8 md:p-12 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 style="font-size: var(--text-h2)" class="font-bold mb-4">{{ section.settings.heading }}</h2>
        <p class="text-white/80 mb-6">{{ section.settings.text }}</p>
        {% render 'btn', variant: 'whatsapp', size: 'lg', label: section.settings.cta, icon: 'whatsapp', href: wa_url, target: '_blank', rel: 'noopener' %}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="rounded-lg overflow-hidden aspect-video">
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: section.settings.heading }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Servicio técnico",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Reparamos computadores y equipos tecnológicos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Diagnóstico, mantenimiento, upgrades y armado de setups gamer. Taller en El Carmen de Viboral." },
    { "type": "text", "id": "cta", "label": "CTA", "default": "Solicitar diagnóstico" },
    { "type": "image_picker", "id": "image", "label": "Imagen taller" }
  ],
  "presets": [{ "name": "Home — Servicio técnico" }]
}
{% endschema %}
