<section class="nt-section">
  <div class="nt-container">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow | default: 'Tecnología seleccionada' }}</p>
        <h2 class="nt-section-title mb-0">{{ section.settings.title }}</h2>
      </div>
      <a href="{{ routes.collections_url }}" class="text-sm font-medium text-brand-royal hover:underline shrink-0 inline-flex items-center gap-1">
        {{ 'home.view_all_categories' | t }}
        {% render 'icon', name: 'arrow-right', size: 14 %}
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 lg:gap-4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign card_title = block.settings.title
          assign card_url = block.settings.url
          assign card_image = block.settings.image
          assign card_icon = block.settings.icon
          assign card_eyebrow = block.settings.eyebrow
          if card_eyebrow == '—'
            assign card_eyebrow = ''
          endif

          assign collection_handle = block.settings.collection
          if col != blank
            if card_title == blank or card_title == 'Categoría'
              assign card_title = col.title
            endif
            if card_url == blank
              assign card_url = col.url
            endif
            if card_image == blank and col.image != blank
              assign card_image = col.image
            endif
          elsif collection_handle != blank
            if card_url == blank
              assign card_url = routes.collections_url | append: '/' | append: collection_handle
            endif
          endif

          assign theme_key = collection_handle
          if theme_key == blank
            assign theme_key = card_title | handleize
          endif
          capture theme_data
            render 'category-theme', handle: theme_key, title: card_title, icon: card_icon
          endcapture
          assign theme_parts = theme_data | strip | split: '|'
          assign card_image_asset = theme_parts | first
          assign card_theme_icon = theme_parts | last
          if card_image_asset == blank
            assign card_image_asset = ''
          endif
          if card_theme_icon != blank
            assign card_icon = card_theme_icon
          endif
          if card_image != blank
            assign card_image_asset = ''
          endif
        -%}
        {%- if card_title != blank -%}
          <div {{ block.shopify_attributes }}>
            {% render 'category-card',
              title: card_title,
              url: card_url,
              image: card_image,
              image_asset: card_image_asset,
              icon: card_icon,
              eyebrow: card_eyebrow
            %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Categorías",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Encuentra tu próximo equipo" },
    { "type": "text", "id": "title", "label": "Título", "default": "Compra por categoría" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección Shopify",
          "info": "Si eliges una colección, se usan su título, enlace e imagen (salvo que los sobrescribas abajo)."
        },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (opcional)", "default": "—", "info": "Usa «—» para ocultar el eyebrow." },
        { "type": "text", "id": "title", "label": "Nombre (opcional si hay colección)", "default": "Categoría", "info": "Déjalo en «Categoría» para usar el título de la colección." },
        { "type": "url", "id": "url", "label": "Enlace (opcional si hay colección)" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "select", "id": "icon", "label": "Ícono fallback", "default": "grid", "options": [
          { "value": "plug", "label": "Accesorios" },
          { "value": "cable", "label": "Cables" },
          { "value": "battery", "label": "Power bank" },
          { "value": "speaker", "label": "Parlantes" },
          { "value": "headset", "label": "Diademas" },
          { "value": "sparkle", "label": "Belleza" },
          { "value": "laptop", "label": "Portátiles" },
          { "value": "cpu", "label": "PC / Componentes" },
          { "value": "monitor", "label": "Monitores" },
          { "value": "keyboard", "label": "Periféricos" },
          { "value": "wifi", "label": "Redes" },
          { "value": "headphones", "label": "Audio" },
          { "value": "gamepad", "label": "Gaming" },
          { "value": "tool", "label": "Servicio técnico" },
          { "value": "grid", "label": "Genérico" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home — Categorías",
      "blocks": [
        { "type": "category", "settings": { "eyebrow": "Trabajo y estudio", "title": "Portátiles", "icon": "laptop" } },
        { "type": "category", "settings": { "eyebrow": "Máximo rendimiento", "title": "PC Gamer", "icon": "cpu" } },
        { "type": "category", "settings": { "eyebrow": "Pantalla pro", "title": "Monitores", "icon": "monitor" } },
        { "type": "category", "settings": { "eyebrow": "Setup completo", "title": "Periféricos", "icon": "keyboard" } },
        { "type": "category", "settings": { "eyebrow": "Conexión sin caídas", "title": "Redes y WiFi", "icon": "wifi" } },
        { "type": "category", "settings": { "eyebrow": "Audio gamer", "title": "Audífonos", "icon": "headphones" } }
      ]
    }
  ]
}
{% endschema %}
