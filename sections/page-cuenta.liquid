{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = 'Hola, necesito ayuda para entrar a mi cuenta NANOTRONICS' | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'account.title' | t
  endif

  assign intro = section.settings.intro
  if intro == blank
    assign intro = 'account.intro' | t
  endif

  assign welcome_name = customer.first_name
  if welcome_name == blank
    assign welcome_name = customer.email
  endif
-%}

<section class="nt-account-page">
  <div class="nt-account-page__header">
    <p class="nt-eyebrow mb-2">{{ 'account.eyebrow' | t }}</p>
    <h1 class="nt-account-page__title">{{ heading }}</h1>
    <p class="nt-account-page__intro">{{ intro }}</p>
  </div>

  {%- if customer -%}
    <div class="nt-account-panel nt-account-panel--logged">
      <div class="nt-account-panel__icon">
        {% render 'icon', name: 'user', size: 28 %}
      </div>
      <p class="nt-account-panel__name">{{ 'account.welcome' | t: name: welcome_name }}</p>
      <p class="nt-account-panel__email">{{ customer.email }}</p>
      <div class="nt-account-panel__actions">
        <a href="{{ routes.account_url }}" class="nt-btn nt-btn--primary nt-btn--lg nt-btn--full">
          {{ 'account.view_orders' | t }}
        </a>
        <a href="{{ routes.account_addresses_url }}" class="nt-btn nt-btn--secondary nt-btn--lg nt-btn--full">
          {{ 'account.manage_addresses' | t }}
        </a>
      </div>
      <a href="{{ routes.account_logout_url }}" class="nt-account-panel__logout">
        {{ 'account.logout' | t }}
      </a>
    </div>
  {%- else -%}
    <div class="nt-account-panel">
      <p class="nt-account-panel__note">{{ 'account.portal_note' | t }}</p>
      <a href="{{ routes.account_login_url }}" class="nt-btn nt-btn--primary nt-btn--xl nt-btn--full">
        {% render 'icon', name: 'user', size: 18 %}
        {{ 'account.login_submit' | t }}
      </a>
      <a href="{{ routes.account_register_url }}" class="nt-btn nt-btn--secondary nt-btn--lg nt-btn--full">
        {{ 'account.register_submit' | t }}
      </a>
    </div>

    <ul class="nt-account-benefits">
      <li>
        {% render 'icon', name: 'package', size: 18, class: 'text-brand-royal shrink-0' %}
        <span>{{ 'account.benefit_orders' | t }}</span>
      </li>
      <li>
        {% render 'icon', name: 'map-pin', size: 18, class: 'text-brand-royal shrink-0' %}
        <span>{{ 'account.benefit_addresses' | t }}</span>
      </li>
      <li>
        {% render 'icon', name: 'headset', size: 18, class: 'text-brand-royal shrink-0' %}
        <span>{{ 'account.benefit_support' | t }}</span>
      </li>
    </ul>

    <div class="nt-account-help">
      <div>
        <p class="font-semibold text-ink">{{ 'account.help_title' | t }}</p>
        <p class="text-sm text-ink-muted mt-1">{{ 'account.help_text' | t }}</p>
      </div>
      <a href="{{ wa_url }}" class="nt-btn nt-btn--whatsapp nt-btn--md shrink-0" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp', size: 18 %}
        {{ 'account.help_whatsapp' | t }}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cuenta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tu cuenta NANOTRONICS"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Consulta pedidos, guarda direcciones y compra más rápido con tu cuenta."
    }
  ],
  "presets": [{ "name": "Cuenta" }]
}
{% endschema %}
