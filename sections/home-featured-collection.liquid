{%- assign collection = collections[section.settings.collection] -%}
<section class="nt-section bg-surface-2">
  <div class="nt-container">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="nt-section-title mb-2">{{ section.settings.title }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="text-ink-muted max-w-xl">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="text-sm font-medium text-brand-royal hover:underline shrink-0 inline-flex items-center gap-1">
          {{ 'home.view_all' | t }}
          {% render 'icon', name: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <div class="col-span-full rounded-xl border border-dashed border-line bg-surface px-6 py-12 text-center">
          <p class="text-ink font-medium mb-1">{{ 'home.empty_featured_title' | t }}</p>
          <p class="text-sm text-ink-muted max-w-md mx-auto">{{ 'home.select_collection' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="inline-flex mt-5 text-sm font-medium text-brand-royal hover:underline">
            {{ 'home.view_catalog' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Destacados",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Top esta semana" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que más están comprando" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Desde 2005 en El Carmen de Viboral. Stock real, garantía mínima de 3 meses y asesoría por WhatsApp." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 2, "default": 8, "label": "Productos a mostrar" }
  ],
  "presets": [{ "name": "Home — Productos destacados" }]
}
{% endschema %}
