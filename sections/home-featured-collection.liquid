{%- assign collection = collections[section.settings.collection] -%}
<section class="nt-section bg-surface-2">
  <div class="nt-container">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nt-eyebrow mb-2">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="nt-section-title mb-2">{{ section.settings.title }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="text-ink-muted max-w-xl">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="text-sm font-medium text-brand-royal hover:underline shrink-0 inline-flex items-center gap-1">
          {{ 'home.view_all' | t }}
          {% render 'icon', name: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card', demo: true, title: 'Parlante JBL Flip 6 · Bluetooth', price: 38990000, compare_at: 44990000, badge: 'oferta', brand: 'JBL' %}
        {% render 'product-card', demo: true, title: 'Portátil ASUS VivoBook 15 · Ryzen 5 16GB', price: 249900000, badge: 'nuevo', brand: 'ASUS' %}
        {% render 'product-card', demo: true, title: 'Monitor Samsung 24" Full HD', price: 59900000, compare_at: 69900000, badge: 'oferta', brand: 'Samsung' %}
        {% render 'product-card', demo: true, title: 'Teclado Logitech K380 Multi-Device', price: 12990000, brand: 'Logitech' %}
        {% render 'product-card', demo: true, title: 'Mouse Logitech M350 Pebble', price: 8990000, brand: 'Logitech' %}
        {% render 'product-card', demo: true, title: 'SSD Kingston NV2 500GB NVMe', price: 15990000, compare_at: 18990000, badge: 'oferta', brand: 'Kingston' %}
        {% render 'product-card', demo: true, title: 'Power bank ADATA 10000mAh', price: 4990000, brand: 'ADATA' %}
        {% render 'product-card', demo: true, title: 'Router Tenda WiFi 6 AX2', price: 19990000, brand: 'Tenda' %}
        <p class="col-span-full text-sm text-ink-muted text-center py-2">
          {{ 'home.select_collection' | t }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Destacados",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Top esta semana" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que más están comprando" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Desde 2005 en El Carmen de Viboral. Stock real, garantía mínima de 3 meses y asesoría por WhatsApp." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 2, "default": 8, "label": "Productos a mostrar" }
  ],
  "presets": [{ "name": "Home — Productos destacados" }]
}
{% endschema %}
