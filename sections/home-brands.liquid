<section class="nt-section--sm border-y border-line bg-surface">
  <div class="nt-container">
    {%- if section.settings.title != blank -%}
      <p class="text-center text-xs text-ink-muted uppercase tracking-[0.2em] mb-5">
        {{ section.settings.title }}
      </p>
    {%- endif -%}
    <div class="nt-brand-strip">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.name }}">
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'nt-brand-strip__item', alt: block.settings.name }}
              </a>
            {%- else -%}
              <span {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'nt-brand-strip__item', alt: block.settings.name }}
              </span>
            {%- endif -%}
          {%- else -%}
            <span class="text-base lg:text-lg font-bold text-ink-muted/60 hover:text-ink transition-colors" {{ block.shopify_attributes }}>
              {{ block.settings.name }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for vendor in shop.vendors -%}
          <a href="{{ vendor | url_for_vendor }}" class="text-base lg:text-lg font-bold text-ink-muted hover:text-brand-royal transition-colors">
            {{ vendor }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Marcas",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Marcas que vendemos" },
    { "type": "paragraph", "content": "Sin bloques, se muestran automáticamente las marcas (proveedores) de los productos publicados. Añade bloques solo para marcas que realmente vendes." }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Marca" },
        { "type": "image_picker", "id": "image", "label": "Logo (opcional)" },
        { "type": "url", "id": "url", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Home — Marcas" }]
}
{% endschema %}
