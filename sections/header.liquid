{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = settings.whatsapp_message | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

<header
  class="nt-header"
  x-data="{ mobileOpen: false, megaOpen: false, scrolled: false }"
  @scroll.window="scrolled = window.scrollY > 6"
  :class="{ 'is-scrolled': scrolled }"
>
  <div class="nt-container nt-header__inner">
    <div class="nt-header__row">
      <a href="{{ routes.root_url }}" class="nt-header__logo" style="--logo-width: {{ logo_w }}px;" aria-label="{{ shop.name }}">
        {%- assign logo_w = settings.logo_width | default: 200 -%}
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: logo_w
            | image_tag:
              loading: 'eager',
              width: logo_w,
              alt: shop.name,
              class: 'nt-header__logo-img'
          }}
        {%- else -%}
          <img
            src="{{ 'nano-logo.png' | asset_url }}"
            alt="NANOTRONICS"
            width="{{ logo_w }}"
            height="48"
            class="nt-header__logo-img"
            loading="eager"
          >
        {%- endif -%}
      </a>

      <div class="nt-header__search hidden sm:block">
        <form action="{{ routes.search_url }}" method="get" role="search" class="relative">
          <input type="hidden" name="type" value="product">
          <label for="header-search" class="nt-sr-only">{{ 'general.search' | t }}</label>
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-muted pointer-events-none">
            {% render 'icon', name: 'search', size: 18 %}
          </span>
          <input
            type="search"
            id="header-search"
            name="q"
            class="nt-input w-full pl-10 pr-28 min-h-12 text-base"
            placeholder="{{ 'general.search' | t }}"
            value="{{ search.terms | escape }}"
            autocomplete="off"
          >
          <button
            type="submit"
            class="absolute right-1.5 top-1/2 -translate-y-1/2 nt-btn nt-btn--primary nt-btn--sm h-9"
          >
            {{ 'general.search_submit' | t }}
          </button>
        </form>
      </div>

      <div class="nt-header__actions">
        <a
          href="tel:{{ settings.store_phone | replace: ' ', '' }}"
          class="hidden xl:flex items-center gap-2 px-3 py-2 rounded-md hover:bg-surface-2 text-sm shrink-0"
          aria-label="{{ 'general.call_us' | t }}"
        >
          {% render 'icon', name: 'headset', size: 22, class: 'text-brand-royal' %}
          <span class="leading-tight">
            <span class="block text-[10px] uppercase tracking-wider text-ink-muted">{{ 'general.support' | t }}</span>
            <span class="block font-semibold text-ink">{{ settings.store_phone }}</span>
          </span>
        </a>

        <a
          href="{{ wa_url }}"
          class="nt-header__icon-btn text-[#25D366] hidden md:flex"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.whatsapp' | t }}"
        >
          {% render 'icon', name: 'whatsapp', size: 22 %}
        </a>

        <a
          href="{{ routes.account_url }}"
          class="nt-header__icon-btn hidden md:flex"
          aria-label="{{ 'general.account' | t }}"
        >
          {% render 'icon', name: 'user', size: 22 %}
        </a>

        <button
          type="button"
          class="nt-header__icon-btn"
          @click="cartOpen = true"
          aria-label="{{ 'general.cart' | t }}"
        >
          {% render 'icon', name: 'cart', size: 22 %}
          <span
            class="nt-cart-pop cart-count-badge"
            {% if cart.item_count == 0 %}style="display:none"{% endif %}
          >
            {{ cart.item_count }}
          </span>
        </button>

        <button
          type="button"
          class="nt-header__icon-btn lg:hidden"
          @click="mobileOpen = !mobileOpen"
          :aria-expanded="mobileOpen"
          aria-controls="mobile-nav"
          aria-label="{{ 'accessibility.menu_toggle' | t }}"
        >
          {% render 'icon', name: 'menu', size: 22 %}
        </button>
      </div>
    </div>

    <nav class="nt-header__nav" aria-label="{{ 'nav.principal' | t }}">
      <div class="relative" @mouseenter="megaOpen = true" @mouseleave="megaOpen = false">
        <a
          href="{{ routes.collections_url }}"
          class="nt-header__nav-link inline-flex items-center gap-1"
        >
          {% render 'icon', name: 'grid', size: 16 %}
          {{ 'general.categories' | t }}
          {% render 'icon', name: 'chevron-down', size: 14 %}
        </a>

        <div x-show="megaOpen" x-cloak class="nt-megamenu" x-transition.opacity.duration.150ms>
          <div class="flex items-center justify-between mb-4">
            <p class="nt-eyebrow">{{ 'general.categories' | t }}</p>
            <a href="{{ routes.collections_url }}" class="text-xs font-medium text-brand-royal hover:underline">
              {{ 'home.view_all_categories' | t }} →
            </a>
          </div>
          <div class="nt-megamenu__grid">
            {% render 'collection-nav-links', link_class: 'nt-megamenu__link', show_icon: true, show_count: true %}
            <a href="{{ routes.all_products_collection_url }}" class="nt-megamenu__link">
              {% render 'icon', name: 'grid', size: 14, class: 'opacity-60' %}
              <span>{{ 'nav.all_products' | t }}</span>
            </a>
          </div>
          <div class="mt-5 pt-4 border-t border-line">
            <a href="/pages/servicio-tecnico" class="flex items-center gap-3 p-3 rounded-lg bg-brand-sky text-brand-deep hover:bg-brand-royal hover:text-white transition-colors">
              {% render 'icon', name: 'tool', size: 20 %}
              <div class="text-sm">
                <p class="font-semibold">{{ 'general.technical_service' | t }}</p>
                <p class="text-xs opacity-80">{{ 'home.service_short' | t }}</p>
              </div>
              {% render 'icon', name: 'arrow-right', size: 16, class: 'ml-auto' %}
            </a>
          </div>
        </div>
      </div>

      <a href="{{ routes.all_products_collection_url }}" class="nt-header__nav-link">
        {{ 'nav.all_products' | t }}
      </a>
      <a
        href="{{ routes.collections_url }}/ofertas"
        class="nt-header__nav-link inline-flex items-center gap-1.5 text-danger hover:bg-danger-soft"
      >
        {% render 'icon', name: 'fire', size: 14 %}
        {{ 'general.offers' | t }}
      </a>
      <a href="/pages/servicio-tecnico" class="nt-header__nav-link inline-flex items-center gap-1.5">
        {% render 'icon', name: 'tool', size: 14 %}
        {{ 'general.technical_service' | t }}
      </a>
      <a href="/pages/nosotros" class="nt-header__nav-link">{{ 'footer.about' | t }}</a>
      <a href="/pages/soporte" class="nt-header__nav-link">{{ 'general.support' | t }}</a>
    </nav>

    <div class="sm:hidden">
      <form action="{{ routes.search_url }}" method="get" role="search" class="relative">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          class="nt-input w-full pl-10 min-h-11"
          placeholder="{{ 'general.search' | t }}"
        >
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted">
          {% render 'icon', name: 'search', size: 18 %}
        </span>
      </form>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="lg:hidden border-t border-line bg-surface max-h-[80vh] overflow-y-auto"
    x-show="mobileOpen"
    x-cloak
    x-transition.opacity.duration.150ms
    @click.outside="mobileOpen = false"
  >
    <nav class="nt-container py-4 flex flex-col gap-1" aria-label="{{ 'nav.mobile' | t }}">
      <a href="{{ routes.root_url }}" class="nt-header__nav-link">{{ 'nav.home' | t }}</a>
      <a href="{{ routes.collections_url }}" class="nt-header__nav-link font-semibold">{{ 'general.categories' | t }}</a>
      {% render 'collection-nav-links', link_class: 'nt-header__nav-link pl-6 text-ink-muted' %}
      <a href="{{ routes.all_products_collection_url }}" class="nt-header__nav-link">
        {{ 'nav.all_products' | t }}
      </a>
      <a
        href="{{ routes.collections_url }}/ofertas"
        class="nt-header__nav-link text-danger inline-flex items-center gap-2"
      >
        {% render 'icon', name: 'fire', size: 14 %} {{ 'general.offers' | t }}
      </a>
      <a href="/pages/servicio-tecnico" class="nt-header__nav-link inline-flex items-center gap-2">
        {% render 'icon', name: 'tool', size: 14 %} {{ 'general.technical_service' | t }}
      </a>
      <a href="/pages/nosotros" class="nt-header__nav-link">{{ 'footer.about' | t }}</a>
      <a href="/pages/soporte" class="nt-header__nav-link">{{ 'general.support' | t }}</a>
      <div class="border-t border-line my-2"></div>
      <a href="{{ wa_url }}" class="nt-header__nav-link text-[#25D366] inline-flex items-center gap-2" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp', size: 16 %} {{ 'general.whatsapp' | t }}
      </a>
      <a href="{{ routes.account_url }}" class="nt-header__nav-link inline-flex items-center gap-2">
        {% render 'icon', name: 'user', size: 16 %} {{ 'general.account' | t }}
      </a>
      <a href="tel:{{ settings.store_phone }}" class="nt-header__nav-link inline-flex items-center gap-2">
        {% render 'icon', name: 'phone', size: 16 %} {{ settings.store_phone }}
      </a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
