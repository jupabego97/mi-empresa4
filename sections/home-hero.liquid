{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = settings.whatsapp_message | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

<section class="nt-hero">
  <div class="nt-hero__bg-glow" aria-hidden="true"></div>
  <div class="nt-hero__bg-grid" aria-hidden="true"></div>

  <div class="nt-container nt-hero__inner">
    <div class="flex flex-col justify-center gap-5 lg:gap-6">
      {%- if section.settings.pill_text != blank -%}
        <span class="nt-hero__pill">
          <span class="nt-hero__pill-dot"></span>
          <span>{{ section.settings.pill_text }}</span>
        </span>
      {%- endif -%}

      <p class="nt-eyebrow !text-brand-glow">{{ section.settings.eyebrow }}</p>

      <h1 style="font-size: var(--text-display)" class="font-bold tracking-tight leading-[1.05]">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="block bg-gradient-to-r from-brand-glow to-white bg-clip-text text-transparent">
            {{ section.settings.heading_accent }}
          </span>
        {%- endif -%}
      </h1>

      <p class="text-base lg:text-lg text-white/75 max-w-xl">{{ section.settings.subheading }}</p>

      <div class="flex flex-col sm:flex-row gap-3 mt-2">
        {% render 'btn',
          variant: 'primary',
          size: 'xl',
          label: section.settings.cta_primary,
          href: section.settings.cta_primary_url
        %}
        {% render 'btn',
          variant: 'whatsapp',
          size: 'xl',
          label: section.settings.cta_whatsapp,
          icon: 'whatsapp',
          href: wa_url,
          target: '_blank',
          rel: 'noopener'
        %}
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/65 mt-1">
        <span class="inline-flex items-center gap-1.5">
          {% render 'icon', name: 'truck', size: 14 %} Despacho en 24h a Colombia
        </span>
        <span class="inline-flex items-center gap-1.5">
          {% render 'icon', name: 'shield-check', size: 14 %} Garantía oficial
        </span>
        <span class="inline-flex items-center gap-1.5">
          {% render 'icon', name: 'credit-card', size: 14 %} Hasta 36 cuotas
        </span>
        <span class="inline-flex items-center gap-1.5">
          {% render 'icon', name: 'tool', size: 14 %} Taller propio
        </span>
      </div>

      {%- if section.settings.show_metrics -%}
        <div class="nt-hero__metrics">
          <div>
            <p class="nt-hero__metric-num">{{ section.settings.metric_1_value | default: settings.metric_clients_value }}</p>
            <p class="nt-hero__metric-label">{{ section.settings.metric_1_label | default: settings.metric_clients_label }}</p>
          </div>
          <div>
            <p class="nt-hero__metric-num">{{ section.settings.metric_2_value | default: settings.metric_rating_value }}</p>
            <p class="nt-hero__metric-label">{{ section.settings.metric_2_label | default: settings.metric_rating_label }}</p>
          </div>
          <div>
            <p class="nt-hero__metric-num">{{ section.settings.metric_3_value | default: settings.metric_dispatch_value }}</p>
            <p class="nt-hero__metric-label">{{ section.settings.metric_3_label | default: settings.metric_dispatch_label }}</p>
          </div>
          <div>
            <p class="nt-hero__metric-num">{{ section.settings.metric_4_value | default: settings.metric_years_value }}</p>
            <p class="nt-hero__metric-label">{{ section.settings.metric_4_label | default: settings.metric_years_label }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="nt-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,900,1200,1400',
            sizes: '(max-width: 1024px) 100vw, 50vw',
            class: 'w-full h-full object-cover',
            alt: section.settings.heading
        }}
      {%- else -%}
        <div class="w-full h-full min-h-[320px] relative bg-gradient-to-br from-brand-royal/40 via-brand-deep-2 to-brand-deep flex items-center justify-center">
          <div class="absolute inset-0 nt-tech-grid opacity-30"></div>
          <div class="text-center text-white/60 text-sm relative z-10 p-6">
            <p class="text-3xl font-black tracking-tight text-white mb-2">NANO/TRONICS</p>
            <p>Sube tu imagen hero en el Theme Editor</p>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_floating_card -%}
        <div class="absolute bottom-4 left-4 right-4 lg:bottom-6 lg:left-auto lg:right-6 lg:max-w-xs nt-card p-4 backdrop-blur-md bg-white/95 text-ink">
          <div class="flex items-start gap-3">
            <div class="shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-success-soft text-success">
              {% render 'icon', name: 'check-circle', size: 20 %}
            </div>
            <div class="text-sm">
              <p class="font-semibold leading-tight">{{ section.settings.floating_title }}</p>
              <p class="text-ink-muted text-xs mt-0.5">{{ section.settings.floating_subtitle }}</p>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Hero",
  "settings": [
    { "type": "text", "id": "pill_text", "label": "Pill (estado)", "default": "Desde 2005 · Parque Principal, Viboral" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tienda y servicio técnico" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tecnología con respaldo local" },
    { "type": "text", "id": "heading_accent", "label": "Título acento", "default": "al son de la tecnología" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Buen precio, amplia variedad y atención que responde. En el corazón de El Carmen de Viboral desde 2005." },
    { "type": "image_picker", "id": "image", "label": "Imagen hero" },
    { "type": "text", "id": "cta_primary", "label": "CTA principal", "default": "Explorar catálogo" },
    { "type": "url", "id": "cta_primary_url", "label": "URL CTA principal" },
    { "type": "text", "id": "cta_whatsapp", "label": "CTA WhatsApp", "default": "Escribir por WhatsApp" },
    { "type": "header", "content": "Métricas confianza" },
    { "type": "checkbox", "id": "show_metrics", "label": "Mostrar métricas", "default": true },
    { "type": "text", "id": "metric_1_value", "label": "Métrica 1 valor", "default": "Desde 2005" },
    { "type": "text", "id": "metric_1_label", "label": "Métrica 1 etiqueta", "default": "En El Carmen de Viboral" },
    { "type": "text", "id": "metric_2_value", "label": "Métrica 2 valor", "default": "4.3★" },
    { "type": "text", "id": "metric_2_label", "label": "Métrica 2 etiqueta", "default": "En Google" },
    { "type": "text", "id": "metric_3_value", "label": "Métrica 3 valor", "default": "21+ años" },
    { "type": "text", "id": "metric_3_label", "label": "Métrica 3 etiqueta", "default": "De trayectoria" },
    { "type": "text", "id": "metric_4_value", "label": "Métrica 4 valor", "default": "~5 min" },
    { "type": "text", "id": "metric_4_label", "label": "Métrica 4 etiqueta", "default": "Respuesta WhatsApp" },
    { "type": "header", "content": "Tarjeta flotante" },
    { "type": "checkbox", "id": "show_floating_card", "label": "Mostrar tarjeta flotante", "default": true },
    { "type": "text", "id": "floating_title", "label": "Tarjeta título", "default": "Paga como prefieras" },
    { "type": "text", "id": "floating_subtitle", "label": "Tarjeta subtítulo", "default": "Hasta 36 cuotas · Sin tarjeta con Addi" }
  ],
  "presets": [{ "name": "Home — Hero" }]
}
{% endschema %}
