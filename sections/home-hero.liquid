{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = settings.whatsapp_message | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  assign brand_name = shop.name | default: 'NANOTRONICS'
-%}

<section class="nt-hero{% if section.settings.image != blank %} nt-hero--has-media{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="nt-hero__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800,1200,1600,2000',
          sizes: '100vw',
          class: 'nt-hero__media-img',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="nt-hero__veil" aria-hidden="true"></div>
  <div class="nt-hero__bg-grid" aria-hidden="true"></div>

  <div class="nt-container nt-hero__inner">
    <div class="nt-hero__copy">
      <p class="nt-hero__brand nt-display">{{ brand_name }}</p>

      <h1 class="nt-hero__heading nt-display">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="nt-hero__accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="nt-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="nt-hero__ctas">
        {% render 'btn',
          variant: 'primary',
          size: 'xl',
          label: section.settings.cta_primary,
          href: section.settings.cta_primary_url
        %}
        {% render 'btn',
          variant: 'whatsapp',
          size: 'xl',
          label: section.settings.cta_whatsapp,
          icon: 'whatsapp',
          href: wa_url,
          target: '_blank',
          rel: 'noopener'
        %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tecnología con respaldo local" },
    { "type": "text", "id": "heading_accent", "label": "Título acento", "default": "al son de la tecnología" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Buen precio, amplia variedad y atención que responde. En el corazón de El Carmen de Viboral desde 2005." },
    { "type": "image_picker", "id": "image", "label": "Imagen hero (fondo a sangre)" },
    { "type": "text", "id": "cta_primary", "label": "CTA principal", "default": "Explorar catálogo" },
    { "type": "url", "id": "cta_primary_url", "label": "URL CTA principal" },
    { "type": "text", "id": "cta_whatsapp", "label": "CTA WhatsApp", "default": "Escribir por WhatsApp" },
    { "type": "header", "content": "Opciones legacy (ocultas por defecto)" },
    { "type": "checkbox", "id": "show_metrics", "label": "Mostrar métricas (no recomendado en hero)", "default": false },
    { "type": "checkbox", "id": "show_floating_card", "label": "Mostrar tarjeta flotante (no recomendado)", "default": false },
    { "type": "text", "id": "pill_text", "label": "Pill (sin uso en layout actual)", "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (sin uso en layout actual)", "default": "" }
  ],
  "presets": [{ "name": "Home — Hero" }]
}
{% endschema %}
