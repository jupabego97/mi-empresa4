{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = 'Hola, necesito ayuda para entrar a mi cuenta NANOTRONICS' | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  assign cuenta_url = '/pages/cuenta'
-%}

<section class="nt-auth-card">
  <div class="nt-auth-card__header">
    <h1 class="nt-auth-card__title">{{ 'account.login_title' | t }}</h1>
    <p class="nt-auth-card__lead">{{ 'account.legacy_redirect' | t }}</p>
  </div>

  <div class="nt-account-panel">
    <p class="nt-account-panel__note">{{ 'account.portal_note' | t }}</p>
    <p class="nt-account-panel__otp">{{ 'account.otp_note' | t }}</p>
    <a href="{{ routes.account_login_url }}" class="nt-btn nt-btn--primary nt-btn--xl nt-btn--full">
      {% render 'icon', name: 'user', size: 18 %}
      {{ 'account.continue' | t }}
    </a>
    <p class="nt-account-panel__register">
      {{ 'account.first_time' | t }}
      <a href="{{ routes.account_register_url }}" class="text-brand-royal font-semibold hover:underline">
        {{ 'account.register_submit' | t }}
      </a>
    </p>
    <a href="{{ cuenta_url }}" class="text-sm text-center text-ink-muted hover:text-brand-royal block pt-1">
      {{ 'account.back_hub' | t }}
    </a>
  </div>

  <div class="nt-auth-card__help">
    <p class="text-sm text-ink-muted mb-1">{{ 'account.help_text' | t }}</p>
    <p class="text-xs text-ink-muted mb-3">{{ 'account.help_hours' | t }}</p>
    <a href="{{ wa_url }}" class="nt-btn nt-btn--whatsapp nt-btn--md nt-btn--full" target="_blank" rel="noopener">
      {% render 'icon', name: 'whatsapp', size: 18 %}
      {{ 'account.help_whatsapp' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
