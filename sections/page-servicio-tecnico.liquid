{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_msg = settings.whatsapp_message_service | default: 'Hola, quiero solicitar servicio técnico para mi equipo'
  assign wa_text = wa_msg | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  assign repair_warranty = settings.repair_warranty_days | default: 30
-%}

{% render 'breadcrumbs' %}

<section class="nt-section pt-0">
  <div class="nt-container">
    <div class="relative overflow-hidden rounded-2xl bg-brand-deep text-white p-6 md:p-12 mb-12">
      <div class="absolute inset-0 nt-tech-grid opacity-25 pointer-events-none"></div>
      <div class="absolute -right-32 top-0 w-96 h-96 rounded-full bg-brand-electric/25 blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl">
        <span class="nt-hero__pill mb-4">
          {% render 'icon', name: 'tool', size: 14 %}
          Servicio técnico en tienda
        </span>
        <h1 style="font-size: var(--text-h1)" class="font-bold tracking-tight mb-4">
          {{ section.settings.heading | default: page.title }}
        </h1>
        <p class="text-lg text-white/75 mb-6">{{ section.settings.intro }}</p>
        <div class="flex flex-wrap gap-3">
          {% render 'btn',
            variant: 'whatsapp',
            size: 'lg',
            label: section.settings.cta,
            icon: 'whatsapp',
            href: wa_url,
            target: '_blank'
          %}
          <a href="tel:{{ settings.store_phone | replace: ' ', '' }}" class="nt-btn nt-btn--secondary nt-btn--lg !bg-white/10 !text-white !border-white/20 hover:!bg-white/20">
            {% render 'icon', name: 'phone', size: 16 %}
            Llamar: {{ settings.store_phone }}
          </a>
        </div>
        <p class="text-xs text-white/55 mt-4">
          Diagnóstico (consultar costo) · {{ settings.metric_years_value | default: '21+ años' }} de trayectoria · Garantía {{ repair_warranty }} días en reparación
        </p>
      </div>
    </div>

    <div class="mb-6">
      <p class="nt-eyebrow mb-2">Lo que reparamos</p>
      <h2 class="nt-section-title mb-0">Servicios que ofrecemos</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      {%- for block in section.blocks -%}
        <div class="nt-card p-6 hover:border-brand-electric/40 transition-colors group" {{ block.shopify_attributes }}>
          <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-brand-sky text-brand-royal mb-4 group-hover:bg-brand-royal group-hover:text-white transition-colors">
            {% render 'icon', name: block.settings.icon | default: 'tool', size: 22 %}
          </div>
          <h3 class="font-semibold text-ink mb-2">{{ block.settings.title }}</h3>
          <p class="text-sm text-ink-muted leading-relaxed">{{ block.settings.text }}</p>
          {%- if block.settings.price_from != blank -%}
            <p class="text-sm font-bold text-brand-royal mt-3">{{ block.settings.price_from }}</p>
          {%- endif -%}
          <ul class="mt-2 space-y-1 text-xs text-ink-muted">
            {%- if block.settings.turnaround != blank -%}
              <li class="inline-flex items-center gap-1.5">
                {% render 'icon', name: 'clock', size: 12, class: 'text-brand-royal' %}
                {{ block.settings.turnaround }}
              </li>
            {%- endif -%}
            {%- if block.settings.warranty_note != blank -%}
              <li class="inline-flex items-center gap-1.5">
                {% render 'icon', name: 'shield-check', size: 12, class: 'text-success' %}
                {{ block.settings.warranty_note }}
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="grid lg:grid-cols-2 gap-10 items-start mb-16">
      <div>
        <p class="nt-eyebrow mb-2">Cómo trabajamos</p>
        <h2 class="nt-section-title">{{ 'service.process' | t }}</h2>
        <ol class="space-y-4 mt-6">
          {%- assign steps_list = section.settings.process_steps | newline_to_br | split: '<br />' -%}
          {%- for step in steps_list -%}
            <li class="flex gap-4">
              <span class="flex shrink-0 w-9 h-9 items-center justify-center rounded-lg bg-brand-royal text-white font-bold text-sm">{{ forloop.index }}</span>
              <span class="text-ink-muted leading-relaxed pt-1.5">{{ step | strip }}</span>
            </li>
          {%- endfor -%}
        </ol>
        <div class="mt-8 p-4 rounded-lg bg-brand-sky border border-brand-electric/20 inline-flex items-start gap-3">
          {% render 'icon', name: 'clock', size: 20, class: 'text-brand-royal shrink-0 mt-0.5' %}
          <div class="text-sm">
            <p class="font-semibold text-ink">{{ 'service.time' | t }}</p>
            <p class="text-ink-muted">{{ section.settings.turnaround }}</p>
          </div>
        </div>
      </div>
      {%- if section.settings.workshop_image != blank -%}
        <div class="rounded-xl overflow-hidden aspect-[4/3] shadow-md">
          {{ section.settings.workshop_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: 'Taller NANOTRONICS' }}
        </div>
      {%- else -%}
        <div class="rounded-xl aspect-[4/3] bg-brand-deep flex items-center justify-center text-white/30">
          {% render 'icon', name: 'tool', size: 80 %}
        </div>
      {%- endif -%}
    </div>

    <div class="relative overflow-hidden text-center p-10 rounded-2xl bg-brand-deep text-white">
      <div class="absolute inset-0 nt-tech-grid opacity-30 pointer-events-none"></div>
      <div class="relative z-10 max-w-xl mx-auto space-y-4">
        <span class="nt-hero__pill mx-auto"><span class="nt-hero__pill-dot"></span><span>Diagnóstico 100% gratuito</span></span>
        <h2 class="text-h2 font-bold">¿Tu equipo necesita una segunda vida?</h2>
        <p class="text-white/75">Escríbenos por WhatsApp con una foto o describiendo lo que pasa. Te damos un primer diagnóstico en minutos, sin compromiso.</p>
        {% render 'btn',
          variant: 'whatsapp',
          size: 'xl',
          label: section.settings.cta,
          icon: 'whatsapp',
          href: wa_url,
          target: '_blank'
        %}
        <p class="text-xs text-white/55">Respuesta promedio: menos de 5 minutos en horario hábil</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Servicio técnico",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Reparamos lo que otros desisten" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Diagnóstico gratuito, repuestos originales y garantía sobre la reparación. Atendemos computadores, portátiles, monitores y consolas — cualquier marca, cualquier modelo." },
    { "type": "textarea", "id": "process_steps", "label": "Pasos del proceso (uno por línea)", "default": "Nos traes tu equipo o lo recogemos\nDiagnóstico gratuito · sin compromiso\nCotización clara · tú decides si avanzamos\nReparamos con repuestos originales\nPruebas de calidad y entrega con garantía" },
    { "type": "text", "id": "turnaround", "label": "Tiempo estimado", "default": "Entre 24 y 72 horas según el caso. Te avisamos siempre por WhatsApp." },
    { "type": "image_picker", "id": "workshop_image", "label": "Foto del taller" },
    { "type": "text", "id": "cta", "label": "CTA", "default": "Pedir diagnóstico gratis" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Servicio",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícono", "options": [
          { "value": "tool", "label": "Reparación" },
          { "value": "shield-check", "label": "Mantenimiento" },
          { "value": "zap", "label": "Upgrade" },
          { "value": "cpu", "label": "Hardware" },
          { "value": "monitor", "label": "Pantalla" },
          { "value": "gamepad", "label": "Setup gamer" },
          { "value": "wifi", "label": "Redes" },
          { "value": "package", "label": "SSD" }
        ], "default": "tool" },
        { "type": "text", "id": "title", "label": "Título", "default": "Reparación" },
        { "type": "text", "id": "text", "label": "Descripción", "default": "Computadores y laptops" },
        { "type": "text", "id": "price_from", "label": "Precio desde", "default": "Consultar", "info": "Ej: Desde $80.000 · VALIDAR en docs/02-catalogo.md" },
        { "type": "text", "id": "turnaround", "label": "Tiempo estimado", "default": "24-72 h" },
        { "type": "text", "id": "warranty_note", "label": "Garantía", "default": "30 días sobre la reparación" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Servicio técnico",
      "blocks": [
        { "type": "service", "settings": { "icon": "tool", "title": "Reparación de hardware", "text": "Tarjeta madre, fuente, pantalla, teclado, batería.", "price_from": "Consultar", "turnaround": "24-72 h", "warranty_note": "30 días garantía" } },
        { "type": "service", "settings": { "icon": "shield-check", "title": "Mantenimiento preventivo", "text": "Limpieza interna y pasta térmica nueva.", "price_from": "Consultar", "turnaround": "24-48 h", "warranty_note": "30 días garantía" } },
        { "type": "service", "settings": { "icon": "zap", "title": "Upgrades de poder", "text": "Más RAM, SSD o GPU. Sin perder archivos.", "price_from": "Consultar", "turnaround": "24 h", "warranty_note": "30 días garantía" } },
        { "type": "service", "settings": { "icon": "package", "title": "Migración a SSD", "text": "Windows y programas migrados sin reinstalar.", "price_from": "Consultar", "turnaround": "24 h", "warranty_note": "30 días garantía" } },
        { "type": "service", "settings": { "icon": "gamepad", "title": "Armados gamer", "text": "Drivers, RGB y benchmarks incluidos.", "price_from": "Consultar", "turnaround": "48 h", "warranty_note": "30 días garantía" } },
        { "type": "service", "settings": { "icon": "monitor", "title": "Recuperación de datos", "text": "Disco dañado o formato accidental.", "price_from": "Cotización previa", "turnaround": "Según caso", "warranty_note": "Presupuesto sin compromiso" } }
      ]
    }
  ]
}
{% endschema %}
