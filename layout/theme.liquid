<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">
<head>
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --color-brand-royal: {{ settings.color_brand_royal | default: '#1D4ED8' }};
      --color-brand-electric: {{ settings.color_brand_electric | default: '#2D7CFF' }};
      --color-brand-deep: {{ settings.color_brand_deep | default: '#050B1F' }};
      --font-display: "Space Grotesk", ui-sans-serif, sans-serif;
      --font-sans: "DM Sans", ui-sans-serif, sans-serif;
    }
    body {
      margin: 0;
      font-family: var(--font-sans);
      background: #fff;
      color: #0a0f1c;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, .nt-display {
      font-family: var(--font-display);
    }
    [x-cloak] { display: none !important; }
    .nt-btn.is-added {
      background: #16a34a !important;
      color: #fff !important;
      box-shadow: 0 1px 0 rgb(255 255 255 / 12%) inset, 0 4px 14px rgba(22, 163, 74, 0.35) !important;
    }
    .nt-btn.is-error {
      background: #dc2626 !important;
      color: #fff !important;
    }
    .nt-cart-toast {
      position: fixed;
      left: 50%;
      bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%) translateY(12px);
      z-index: 80;
      max-width: min(92vw, 360px);
      padding: 12px 18px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      background: #050b1f;
      box-shadow: 0 10px 30px rgba(5, 11, 31, 0.25);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .nt-cart-toast.is-visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    .nt-cart-toast--success { background: #16a34a; }
    .nt-cart-toast--error { background: #dc2626; }
    @media (min-width: 1024px) {
      .nt-cart-toast { bottom: 24px; }
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
  {{ content_for_header }}

  <script defer src="{{ 'alpine.min.js' | asset_url }}"></script>
  <script>
    window.theme = window.theme || {};
    window.theme.moneyFormat = {{ shop.money_format | json }};
    window.theme.labels = {
      add: {{ 'general.add_to_cart' | t | json }},
      adding: {{ 'general.adding_to_cart' | t | json }},
      added: {{ 'general.added_to_cart' | t | json }},
      error: {{ 'general.add_error' | t | json }},
      selectVariant: {{ 'product.select_variant' | t | json }},
      soldOut: {{ 'general.out_of_stock' | t | json }},
      stockIn: {{ 'product.stock_in' | t | json }},
      stockOut: {{ 'product.stock_out' | t | json }},
      cartError: {{ 'cart.update_error' | t | json }}
    };
  </script>
  <script defer src="{{ 'theme.js' | asset_url }}"></script>
</head>
<body
  class="min-h-screen flex flex-col pb-16 lg:pb-0"
  x-data="{ cartOpen: false }"
  @keydown.escape.window="cartOpen = false; window.dispatchEvent(new CustomEvent('close-cart'))"
  @open-cart.window="cartOpen = true"
  @close-cart.window="cartOpen = false"
>
  <a href="#main-content" class="nt-sr-only focus:nt-not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-royal focus:text-white focus:rounded-md">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main-content" role="main" class="flex-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% section 'cart-drawer' %}
  {% render 'icon-sprite' %}
  {% render 'whatsapp-fab' %}
  {% render 'mobile-bottom-nav' %}
</body>
</html>
