{
  "name": "nanotronics-theme",
  "version": "1.0.0",
  "private": true,
  "description": "NANOTRONICS — Shopify theme",
  "scripts": {
    "dev": "tailwindcss -i src/tailwind.css -o assets/theme.css --watch",
    "build": "node tools/build-icons.mjs && npm run build:css",
    "build:css": "tailwindcss -i src/tailwind.css -o assets/theme.css --minify",
    "build:icons": "node tools/build-icons.mjs",
    "theme:dev": "shopify theme dev",
    "theme:push": "shopify theme push",
    "pages:assign": "node tools/assign-pages.mjs",
    "postinstall": "node tools/copy-alpine.mjs",
    "lint:shopify": "node tools/lint-shopify.mjs",
    "theme:check": "node tools/theme-check.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "check": "npm run lint:shopify && npm run theme:check"
  },
  "devDependencies": {
    "@shopify/theme-check-node": "^3.30.1",
    "@tailwindcss/cli": "^4.1.8",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.1.8"
  },
  "dependencies": {
    "alpinejs": "^3.14.9"
  }
}
