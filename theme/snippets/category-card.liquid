<a href="{{ url | default: '#' }}" class="nt-category-card group">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 600
      | image_tag:
        loading: 'lazy',
        class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-250 group-hover:scale-105',
        alt: title
    }}
  {%- else -%}
    <div class="absolute inset-0 bg-gradient-to-br from-brand-royal to-brand-deep"></div>
  {%- endif -%}
  <span class="nt-category-card__overlay"></span>
  <span class="nt-category-card__title">{{ title }}</span>
</a>
