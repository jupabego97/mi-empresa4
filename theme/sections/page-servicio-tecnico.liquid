{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_text = 'Hola, quiero solicitar servicio técnico' | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

{% render 'breadcrumbs' %}

<section class="nt-section pt-0">
  <div class="nt-container">
    <div class="max-w-3xl mb-12">
      <h1 style="font-size: var(--text-h1)" class="font-bold tracking-tight text-brand-deep mb-4">
        {{ section.settings.heading | default: page.title }}
      </h1>
      <p class="text-lg text-ink-muted">{{ section.settings.intro }}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {%- for block in section.blocks -%}
        <div class="p-6 rounded-lg border border-line bg-surface" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon | default: 'check', size: 28, class: 'text-brand-royal mb-4' %}
          <h3 class="font-semibold text-ink mb-2">{{ block.settings.title }}</h3>
          <p class="text-sm text-ink-muted">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start mb-16">
      <div>
        <h2 class="nt-section-title">{{ 'service.process' | t }}</h2>
        <ol class="space-y-4">
          {%- assign steps_list = section.settings.process_steps | newline_to_br | split: '<br />' -%}
          {%- for step in steps_list -%}
            <li class="flex gap-3 text-sm">
              <span class="flex shrink-0 w-8 h-8 items-center justify-center rounded-full bg-brand-royal text-white font-semibold text-xs">{{ forloop.index }}</span>
              <span class="text-ink-muted pt-1">{{ step | strip }}</span>
            </li>
          {%- endfor -%}
        </ol>
        <p class="mt-6 text-sm font-medium text-ink">{{ 'service.time' | t }}: {{ section.settings.turnaround }}</p>
      </div>
      {%- if section.settings.workshop_image != blank -%}
        <div class="rounded-lg overflow-hidden aspect-video">
          {{ section.settings.workshop_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: 'Taller NANOTRONICS' }}
        </div>
      {%- endif -%}
    </div>

    <div class="text-center p-8 rounded-xl bg-brand-deep text-white">
      <h2 class="text-h3 font-bold mb-4">{{ 'service.cta_heading' | t }}</h2>
      {% render 'btn', variant: 'whatsapp', size: 'lg', label: section.settings.cta, icon: 'whatsapp', href: wa_url, target: '_blank', full: false %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Servicio técnico",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Servicio técnico especializado" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Reparación, mantenimiento y upgrades de computadores y equipos tecnológicos en El Carmen de Viboral." },
    { "type": "textarea", "id": "process_steps", "label": "Pasos del proceso (uno por línea)", "default": "Recibimos tu equipo\nDiagnóstico gratuito\nCotización aprobada\nReparación y pruebas\nEntrega con garantía" },
    { "type": "text", "id": "turnaround", "label": "Tiempo estimado", "default": "24–72 horas según complejidad" },
    { "type": "image_picker", "id": "workshop_image", "label": "Foto del taller" },
    { "type": "text", "id": "cta", "label": "CTA", "default": "Solicitar diagnóstico por WhatsApp" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Servicio",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícono", "options": [
          { "value": "check", "label": "Check" },
          { "value": "shield", "label": "Shield" },
          { "value": "star", "label": "Star" }
        ], "default": "check" },
        { "type": "text", "id": "title", "label": "Título", "default": "Reparación" },
        { "type": "text", "id": "text", "label": "Descripción", "default": "Computadores y laptops" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Servicio técnico",
      "blocks": [
        { "type": "service", "settings": { "title": "Reparación", "text": "Diagnóstico y reparación de hardware" } },
        { "type": "service", "settings": { "title": "Mantenimiento", "text": "Limpieza, pasta térmica, optimización" } },
        { "type": "service", "settings": { "title": "Upgrades", "text": "SSD, RAM, GPU y más" } },
        { "type": "service", "settings": { "title": "Instalación SSD", "text": "Migración de datos incluida" } },
        { "type": "service", "settings": { "title": "Gaming setups", "text": "Armado y configuración profesional" } },
        { "type": "service", "settings": { "title": "Diagnóstico", "text": "Evaluación sin compromiso" } }
      ]
    }
  ]
}
{% endschema %}
