{%- liquid
  assign wa_number = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign wa_msg = 'Hola, me interesa: ' | append: product.title
  assign wa_text = wa_msg | url_encode
  assign wa_product_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

{% render 'breadcrumbs' %}

<section class="nt-section pt-0 pb-24 lg:pb-16">
  <div class="nt-container">
    <div class="nt-pdp-grid mb-12">
      <div>
        {% render 'product-gallery', product: product %}
      </div>

      <div class="space-y-4">
        <h1 style="font-size: var(--text-h2)" class="font-bold tracking-tight">{{ product.title }}</h1>

        <div class="flex items-center gap-2">
          {%- for i in (1..5) -%}
            {% render 'icon', name: 'star', size: 14, class: 'text-warning fill-warning' %}
          {%- endfor -%}
          <span class="text-sm text-ink-muted">(5.0)</span>
        </div>

        {% render 'price', product: product %}

        <p class="text-sm font-medium {% if product.available %}text-success{% else %}text-danger{% endif %}">
          {%- if product.available -%}
            {{ 'general.in_stock' | t }}
          {%- else -%}
            {{ 'general.out_of_stock' | t }}
          {%- endif -%}
        </p>

        {% render 'trust-badges' %}
        {% render 'product-form', product: product %}
        {% render 'payment-icons' %}
      </div>
    </div>

    <div class="max-w-3xl space-y-0 border-t border-line" x-data="{ openFaq: null }">
      <div class="border-b border-line py-6">
        <h2 class="text-h4 font-semibold mb-4">{{ 'product.description' | t }}</h2>
        <div class="text-ink-muted rte">{{ product.description }}</div>
      </div>

      <div class="border-b border-line">
        <button type="button" class="nt-accordion__trigger" @click="openFaq = openFaq === 1 ? null : 1">
          <span>{{ 'product.faq' | t }}</span>
          {% render 'icon', name: 'chevron', size: 18 %}
        </button>
        <div class="nt-accordion__content" x-show="openFaq === 1" x-cloak>
          <p>{{ 'product.faq_answer' | t }}</p>
        </div>
      </div>
    </div>

    {%- if product.collections.size > 0 -%}
      {%- assign related_col = product.collections.first -%}
      <div class="mt-16">
        <h2 class="nt-section-title">{{ 'product.related' | t }}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {%- assign shown = 0 -%}
          {%- for related in related_col.products -%}
            {%- if related.id != product.id and shown < 4 -%}
              {% render 'product-card', product: related %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- capture add_label -%}{{ 'general.add_to_cart' | t }}{%- endcapture -%}
<div class="nt-sticky-bar pb-safe lg:hidden">
  <div class="flex gap-2 max-w-lg mx-auto">
    <a href="{{ wa_product_url }}" class="nt-btn nt-btn--whatsapp nt-btn--md shrink-0" target="_blank" rel="noopener">
      {% render 'icon', name: 'whatsapp', size: 20 %}
    </a>
    <button type="submit" form="product-form" class="nt-btn nt-btn--primary nt-btn--md flex-1" {% unless product.available %}disabled{% endunless %}>
      {{ add_label }}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Producto",
  "settings": []
}
{% endschema %}
